Reject managed trusted-snapshot replacement on OpenBSD.
Index: codex-rs/core/src/config/mod.rs
--- codex-rs/core/src/config/mod.rs.orig
+++ codex-rs/core/src/config/mod.rs
@@ -407,6 +407,13 @@ impl Permissions {
         &mut self,
         snapshot: PermissionProfileSnapshot,
     ) -> ConstraintResult<()> {
+        #[cfg(target_os = "openbsd")]
+        if matches!(
+            snapshot.permission_profile(),
+            PermissionProfile::Managed { .. }
+        ) {
+            return Err(codex_config::ConstraintError::OpenBsdManagedSandboxUnavailable);
+        }
         let permission_profile = Constrained::allow_only(snapshot.permission_profile().clone());
         self.permission_profile_state =
             PermissionProfileState::from_constrained_snapshot(permission_profile, snapshot)?;
