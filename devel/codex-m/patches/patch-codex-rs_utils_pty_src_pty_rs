+// Allocate in the parent; take the descriptor snapshot only in the child so it
+// includes std::process's private CLOEXEC error pipe and concurrent parent opens.
+// KERN_FILE requires an unpledged process.
+#[cfg(target_os = "openbsd")]
+pub(crate) struct OpenBsdFdCleanup {
+    mib: [libc::c_int; 6],
+    descriptors: Vec<std::mem::MaybeUninit<libc::kinfo_file>>,
+}
+
+#[cfg(target_os = "openbsd")]
+impl OpenBsdFdCleanup {
+    pub(crate) fn new() -> std::io::Result<Self> {
+        let mut mib = [
+            libc::CTL_KERN,
+            libc::KERN_FILE,
+            libc::KERN_FILE_BYPID,
+            unsafe { libc::getpid() },
+            std::mem::size_of::<libc::kinfo_file>() as libc::c_int,
+            libc::c_int::MAX,
+        ];
+        let mut bytes = 0;
+        // SAFETY: A null output buffer requests the size, including kernel slop.
+        if unsafe {
+            libc::sysctl(
+                mib.as_ptr(),
+                6,
+                std::ptr::null_mut(),
+                &mut bytes,
+                std::ptr::null_mut(),
+                0,
+            )
+        } == -1 {
+            return Err(std::io::Error::last_os_error());
+        }
+        let mut limit: libc::rlimit = unsafe { std::mem::zeroed() };
+        if unsafe { libc::getrlimit(libc::RLIMIT_NOFILE, &mut limit) } == -1 {
+            return Err(std::io::Error::last_os_error());
+        }
+        // Allow concurrent opens up to the current limit, plus cwd/root/text/trace.
+        // The snapshot size also covers already-open descriptors above a lowered
+        // limit. Neither value is used as a bound on descriptor numbers.
+        let limit_count = usize::try_from(limit.rlim_cur)
+            .ok()
+            .and_then(|count| count.checked_add(4))
+            .ok_or_else(|| std::io::Error::from_raw_os_error(libc::EOVERFLOW))?;
+        let count = (bytes / std::mem::size_of::<libc::kinfo_file>()).max(limit_count);
+        mib[5] = libc::c_int::try_from(count)
+            .map_err(|_| std::io::Error::from_raw_os_error(libc::EOVERFLOW))?;
+        let mut descriptors = Vec::new();
+        descriptors
+            .try_reserve_exact(count)
+            .map_err(|_| std::io::Error::from_raw_os_error(libc::ENOMEM))?;
+        descriptors.resize_with(count, std::mem::MaybeUninit::uninit);
+        Ok(Self { mib, descriptors })
+    }
+
+    pub(crate) fn close_inherited_fds_except(
+        &mut self,
+        preserved_fds: &[RawFd],
+    ) -> std::io::Result<()> {
+        // SAFETY: Only syscalls and preallocated storage are used after fork.
+        // Block handlers while taking and consuming the child's snapshot.
+        unsafe {
+            let mut all_signals: libc::sigset_t = std::mem::zeroed();
+            let mut old_mask: libc::sigset_t = std::mem::zeroed();
+            if libc::sigfillset(&mut all_signals) == -1
+                || libc::sigprocmask(libc::SIG_BLOCK, &all_signals, &mut old_mask) == -1
+            {
+                return Err(std::io::Error::last_os_error());
+            }
+            let result = (|| {
+                self.mib[3] = libc::getpid();
+                let capacity = std::mem::size_of_val(self.descriptors.as_slice());
+                let mut bytes = capacity;
+                // ENOMEM means an incomplete snapshot: fail the spawn rather
+                // than leak descriptors if the table grew since preparation.
+                if libc::sysctl(
+                    self.mib.as_ptr(),
+                    6,
+                    self.descriptors.as_mut_ptr().cast(),
+                    &mut bytes,
+                    std::ptr::null_mut(),
+                    0,
+                ) == -1
+                {
+                    return Err(std::io::Error::last_os_error());
+                }
+                let entry_size = std::mem::size_of::<libc::kinfo_file>();
+                if bytes > capacity || bytes % entry_size != 0 {
+                    return Err(std::io::Error::from_raw_os_error(libc::EIO));
+                }
+                for entry in &self.descriptors[..bytes / entry_size] {
+                    let entry = entry.assume_init_ref();
+                    let fd = entry.fd_fd;
+                    // Negative entries describe cwd/root/text, not descriptors.
+                    // UF_EXCLOSE in fd_ofileflags is OpenBSD's FD_CLOEXEC bit.
+                    if fd > libc::STDERR_FILENO
+                        && !preserved_fds.contains(&fd)
+                        && entry.fd_ofileflags & libc::FD_CLOEXEC as u32 == 0
+                        && libc::close(fd) == -1
+                    {
+                        return Err(std::io::Error::last_os_error());
+                    }
+                }
+                Ok(())
+            })();
+            if libc::sigprocmask(libc::SIG_SETMASK, &old_mask, std::ptr::null_mut()) == -1 {
+                return Err(std::io::Error::last_os_error());
+            }
+            result
+        }
+    }
+}
