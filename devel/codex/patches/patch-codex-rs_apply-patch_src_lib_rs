Preserve the anyhow error chain when reporting patch verification failures;
the outer error alone hides the filesystem failure useful for diagnosis.

Index: codex-rs/apply-patch/src/lib.rs
--- codex-rs/apply-patch/src/lib.rs.orig
+++ codex-rs/apply-patch/src/lib.rs
@@ -406,7 +406,7 @@
             Ok(delta)
         }
         Err(error) => {
-            let msg = error.to_string();
+            let msg = format!("{error:#}");
             writeln!(stderr, "{msg}").map_err(|error| {
                 ApplyPatchFailure::new(ApplyPatchError::from(error), delta.clone())
             })?;
