Reject managed network enforcement before the native-process launch
shortcut. An HTTP proxy alone cannot enforce command egress policy when
OpenBSD has no supported command sandbox.

Index: codex-rs/exec-server/src/process_sandbox.rs
--- codex-rs/exec-server/src/process_sandbox.rs.orig
+++ codex-rs/exec-server/src/process_sandbox.rs
@@ -121,6 +121,14 @@ pub(crate) async fn prepare_exec_request
     telemetry: &ProcessTelemetry,
 ) -> Result<PreparedExecRequest, JSONRPCErrorError> {
     let network_proxy = params.network_proxy.clone();
+    // A proxy environment cannot enforce egress policy without a command
+    // sandbox. Check before the sandbox=None native-launch shortcut too.
+    #[cfg(target_os = "openbsd")]
+    if params.enforce_managed_network {
+        return Err(invalid_params(
+            "OpenBSD cannot enforce managed command networking: no supported command sandbox is available".to_string(),
+        ));
+    }
     if let Some(sandbox) = params.sandbox.as_ref()
         && sandbox.windows_sandbox_selection == WindowsSandboxSelection::Mxc
     {
