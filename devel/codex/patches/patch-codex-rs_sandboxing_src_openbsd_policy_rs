+/// Translates a Codex permission profile into an OpenBSD sandbox policy.
+///
+/// `sandbox_policy_cwd` is the working directory that relative profile entries
+/// resolve against, exactly as the other platform backends use it.
+///
+/// `enforce_managed_network` requires proxy-only egress. Unveil does not
+/// restrict network syscalls, so both proxy containment and disabled network
+/// access must be rejected rather than silently granting network access.
+///
+/// # Errors
+///
+/// Returns [`OpenBsdPolicyError::Unsupported`] when the profile cannot be
+/// represented faithfully. The sandbox must not fall back to running the
+/// command unrestricted in that case.
+pub fn translate_permission_profile(
+    permission_profile: &PermissionProfile,
+    sandbox_policy_cwd: &Path,
+    enforce_managed_network: bool,
+) -> Result<OpenBsdSandboxPolicy, OpenBsdPolicyError> {
+    if matches!(permission_profile, PermissionProfile::Managed { .. }) {
+        return Err(OpenBsdPolicyError::Unsupported(
+            "managed permission profiles cannot be enforced by the OpenBSD backend".to_string(),
+        ));
+    }
+
+    let file_system = permission_profile.file_system_sandbox_policy();
+    let network = permission_profile.network_sandbox_policy().is_enabled();
+
+    if enforce_managed_network {
+        return Err(OpenBsdPolicyError::Unsupported(
+            "a managed network proxy requires proxy-only egress, which unveil(2) cannot enforce"
+                .to_string(),
+        ));
+    }
+
+    require_unrestricted_network(network)?;
+
+    if !matches!(file_system.kind, FileSystemSandboxKind::Restricted) {
+        // `unrestricted` and `external-sandbox` profiles do not ask Codex to
+        // build a filesystem sandbox, so Codex must not add one.
+        return Ok(OpenBsdSandboxPolicy {
+            restrict_filesystem: false,
+            writable: true,
+            network,
+            rules: Vec::new(),
+        });
+    }
+
+    if file_system.has_full_disk_write_access() {
+        let mut rules = vec![OpenBsdUnveilRule {
+            path: PathBuf::from("/"),
+            permissions: OpenBsdPermissions::READ_WRITE_CREATE_EXECUTE,
+        }];
+        append_deny_rules(&file_system, sandbox_policy_cwd, &mut rules)?;
+        let writable = rules.iter().any(|rule| rule.permissions.is_writable());
+        append_null_device_rule(&file_system, sandbox_policy_cwd, &mut rules);
+        return Ok(OpenBsdSandboxPolicy {
+            restrict_filesystem: true,
+            writable,
+            network,
+            rules,
+        });
+    }
+
+    let mut readable_policy = file_system.clone();
+    readable_policy
+        .entries
+        .retain(|entry| entry.access != codex_protocol::permissions::FileSystemAccessMode::Deny);
+    // Do not erase a denial of `/`: the unreadable-root adapter deliberately
+    // omits that root to preserve narrow allowlists in other backends.
+    if !readable_policy.has_full_disk_read_access()
+        || !file_system.can_read_local_path_with_cwd(Path::new("/"), sandbox_policy_cwd)
+    {
+        return Err(OpenBsdPolicyError::Unsupported(
+            "this backend requires a full-disk read grant, optionally narrowed by exact \
+             path denials; narrow read allowlists are not implemented"
+                .to_string(),
+        ));
+    }
+
+    // Read everything, then make the configured roots writable and carve the
+    // protected descendants back to read-only. The kernel applies the most
+    // specific matching rule, so a deeper rule shadows the broader one.
+    let mut rules = vec![OpenBsdUnveilRule {
+        path: PathBuf::from("/"),
+        permissions: OpenBsdPermissions::READ_EXECUTE,
+    }];
+    for root in file_system.get_writable_roots_with_cwd(sandbox_policy_cwd) {
+        push_rule(
+            &mut rules,
+            root.root.to_path_buf(),
+            OpenBsdPermissions::READ_WRITE_CREATE_EXECUTE,
+        );
+        for subpath in &root.read_only_subpaths {
+            push_rule(
+                &mut rules,
+                subpath.to_path_buf(),
+                OpenBsdPermissions::READ_EXECUTE,
+            );
+        }
+        for name in &root.protected_metadata_names {
+            push_rule(
+                &mut rules,
+                root.root.join(name.as_str()).to_path_buf(),
+                OpenBsdPermissions::READ_EXECUTE,
+            );
+        }
+    }
+
+    append_deny_rules(&file_system, sandbox_policy_cwd, &mut rules)?;
+
+    let writable = rules.iter().any(|rule| rule.permissions.is_writable());
+    append_null_device_rule(&file_system, sandbox_policy_cwd, &mut rules);
+    Ok(OpenBsdSandboxPolicy {
+        restrict_filesystem: true,
+        writable,
+        network,
+        rules,
+    })
+}
+
+/// Permit shell output redirection to the null device, as upstream's other
+/// backends do. Explicit read denials of this path or its ancestors take
+/// precedence, as do existing rules for this exact path. Never try to widen
+/// an earlier rule, which unveil would reject. The helper checks that the
+/// device is not a regular file or symlink before installing the rules.
+/// No directory is made writable here.
+fn append_null_device_rule(
+    file_system: &FileSystemSandboxPolicy,
+    sandbox_policy_cwd: &Path,
+    rules: &mut Vec<OpenBsdUnveilRule>,
+) {
+    let path = Path::new("/dev/null");
+    if file_system.can_read_local_path_with_cwd(path, sandbox_policy_cwd)
+        && !rules.iter().any(|rule| rule.path == path)
+    {
+        push_rule(rules, path.to_path_buf(), OpenBsdPermissions::READ_WRITE);
+    }
+}
+
+/// Validates a policy before the helper applies it.
+///
+/// The policy is produced by the trusted controller, but it crosses a process
+/// boundary as text, so the helper re-checks it instead of assuming the
+/// controller was correct. A malformed policy is rejected rather than applied.
+///
+/// # Errors
+///
+/// Returns [`OpenBsdPolicyError::Invalid`] for an empty or relative rule path,
+/// or for a restricted policy that carries no rule at all (locking such a
+/// configuration would deny the entire filesystem, including the program about
+/// to be executed).
+pub fn validate_policy(policy: &OpenBsdSandboxPolicy) -> Result<(), OpenBsdPolicyError> {
+    require_unrestricted_network(policy.network)?;
+    if policy.restrict_filesystem && policy.rules.is_empty() {
+        return Err(OpenBsdPolicyError::Invalid(
+            "restricted policy without any unveil rule".to_string(),
+        ));
+    }
+    for rule in &policy.rules {
+        if rule.path.as_os_str().is_empty() {
+            return Err(OpenBsdPolicyError::Invalid(
+                "unveil rule with an empty path".to_string(),
+            ));
+        }
+        if !rule.path.is_absolute() {
+            return Err(OpenBsdPolicyError::Invalid(format!(
+                "unveil rule path is not absolute: {}",
+                rule.path.display()
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// Reject network containment before applying any filesystem restriction.
+fn require_unrestricted_network(network: bool) -> Result<(), OpenBsdPolicyError> {
+    if !network {
+        return Err(OpenBsdPolicyError::Unsupported(
+            "network isolation is unavailable with the OpenBSD unveil backend; \
+             select a profile with network access enabled explicitly"
+                .to_string(),
+        ));
+    }
+    Ok(())
+}
+
+/// Appends `unveil(2)` rules that deny read access to explicit paths.
+///
+/// Glob-based read denials cannot be expressed as unveil rules and are
+/// rejected.
+fn append_deny_rules(
+    file_system: &FileSystemSandboxPolicy,
+    sandbox_policy_cwd: &Path,
+    rules: &mut Vec<OpenBsdUnveilRule>,
+) -> Result<(), OpenBsdPolicyError> {
+    let globs = file_system.get_unreadable_globs_with_cwd(sandbox_policy_cwd);
+    if !globs.is_empty() {
+        return Err(OpenBsdPolicyError::Unsupported(format!(
+            "glob-based read denials cannot be expressed with unveil(2): {globs:?}"
+        )));
+    }
+
+    for path in file_system.get_unreadable_roots_with_cwd(sandbox_policy_cwd) {
+        push_rule(rules, path.to_path_buf(), OpenBsdPermissions::NONE);
+    }
+
+    Ok(())
+}
+
+/// Appends a rule unless an identical one is already present.
+///
+/// Ordering does not affect enforcement (the kernel always picks the most
+/// specific matching rule), but de-duplicating keeps the policy small and makes
+/// the output deterministic for tests.
+fn push_rule(rules: &mut Vec<OpenBsdUnveilRule>, path: PathBuf, permissions: OpenBsdPermissions) {
+    let rule = OpenBsdUnveilRule { path, permissions };
+    if !rules.contains(&rule) {
+        rules.push(rule);
+    }
+}
