+    #[test]
+    fn root_read_denial_cannot_turn_into_full_disk_read() {
+        let root = AbsolutePathBuf::from_absolute_path("/").expect("absolute");
+        let mut entries = FileSystemSandboxPolicy::read_only().entries;
+        entries.push(FileSystemSandboxEntry::new(
+            FileSystemPath::Path {
+                path: PathUri::from_abs_path(&root),
+            },
+            FileSystemAccessMode::Deny,
+        ));
+        let profile = PermissionProfile::from_runtime_permissions(
+            &FileSystemSandboxPolicy::restricted(entries),
+            NetworkSandboxPolicy::Enabled,
+        );
+        assert!(matches!(
+            translate_permission_profile(&profile, &cwd(), false),
+            Err(OpenBsdPolicyError::Unsupported(_))
+        ));
+    }
