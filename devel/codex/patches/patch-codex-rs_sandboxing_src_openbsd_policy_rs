+
+        let mut policy = translate_permission_profile(&read_only_with_network(), &cwd(), false)
+            .expect("translate");
+        policy.rules.push(OpenBsdUnveilRule {
+            path: PathBuf::new(),
+            permissions: OpenBsdPermissions::READ_EXECUTE,
