+    .unwrap();
+}
+
+#[test]
+fn cloexec_remains_open_until_exec() {
+    run_case(&[(128, true), (high_fd(), true)], &[], false, false).unwrap();
+}
+
+#[test]
+fn lowered_limit_does_not_hide_high_descriptor() {
+    run_case(&[(high_fd(), false)], &[], true, false).unwrap();
