+#[test]
+fn incomplete_snapshot_aborts_spawn_and_restores_mask() {
+    let mut cleanup = OpenBsdFdCleanup::new().unwrap();
+    cleanup.descriptors.truncate(1);
+    let mut command = command();
+    unsafe {
+        command.pre_exec(move || {
+            let mut before: libc::sigset_t = std::mem::zeroed();
+            let mut after: libc::sigset_t = std::mem::zeroed();
+            if libc::sigprocmask(libc::SIG_BLOCK, std::ptr::null(), &mut before) == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            let error = match cleanup.close_inherited_fds_except(&[]) {
+                Err(error) => error,
+                Ok(()) => return Err(io::Error::from_raw_os_error(libc::EIO)),
+            };
+            if libc::sigprocmask(libc::SIG_BLOCK, std::ptr::null(), &mut after) == -1
+                || before != after
+            {
+                return Err(io::Error::from_raw_os_error(libc::EIO));
+            }
+            Err(error)
+        });
+    }
+    assert_eq!(
+        command.spawn().unwrap_err().raw_os_error(),
+        Some(libc::ENOMEM)
+    );
+}
+
+#[test]
+fn invalid_sysctl_aborts_spawn() {
+    let mut cleanup = OpenBsdFdCleanup::new().unwrap();
+    cleanup.mib[1] = -1;
+    let mut command = command();
+    unsafe {
+        command.pre_exec(move || cleanup.close_inherited_fds_except(&[]));
+    }
+    assert!(command.spawn().unwrap_err().raw_os_error().is_some());
+}
+
+#[test]
+fn parent_flags_and_mask_are_unchanged() {
+    let file = File::open("/dev/null").unwrap();
+    let flags = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFD) };
+    let mut before: libc::sigset_t = unsafe { std::mem::zeroed() };
+    let mut after: libc::sigset_t = unsafe { std::mem::zeroed() };
+    assert_eq!(
+        unsafe { libc::sigprocmask(libc::SIG_BLOCK, std::ptr::null(), &mut before) },
+        0
+    );
+    run_case(&[(128, true)], &[128], false, false).unwrap();
+    assert_eq!(unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFD) }, flags);
+    assert_eq!(
+        unsafe { libc::sigprocmask(libc::SIG_BLOCK, std::ptr::null(), &mut after) },
+        0
+    );
+    assert_eq!(before, after);
+}
