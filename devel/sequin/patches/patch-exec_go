+type capturedOutput struct {
+	mu   sync.Mutex
+	data bytes.Buffer
+}
+
+func (out *capturedOutput) Write(p []byte) (int, error) {
+	out.mu.Lock()
+	defer out.mu.Unlock()
+	return out.data.Write(p)
+}
+
+func (out *capturedOutput) snapshot() []byte {
+	out.mu.Lock()
+	defer out.mu.Unlock()
+	return bytes.Clone(out.data.Bytes())
+}
