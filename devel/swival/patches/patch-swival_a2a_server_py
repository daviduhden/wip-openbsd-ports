+    @staticmethod
+    def _is_loopback_host(host: str | None) -> bool:
+        """Classify local names and address literals without resolving DNS."""
+        if not host:
+            return False
+        host = host.lower()
+        # OpenBSD resolves these reserved names locally, without DNS.
+        if host in ("localhost", "localhost.") or host.endswith(
+            (".localhost", ".localhost.")
+        ):
+            return True
+        try:
+            address = ipaddress.ip_address(host)
+        except ValueError:
+            return False
+        if address.is_loopback:
+            return True
+        return (
+            isinstance(address, ipaddress.IPv6Address)
+            and address.ipv4_mapped is not None
+            and address.ipv4_mapped.is_loopback
+        )
+
