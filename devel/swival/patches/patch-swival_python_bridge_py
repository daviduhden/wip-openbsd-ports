+def _check_json_depth(frame: bytes) -> None:
+    """Bound JSON decoder recursion before it exhausts the
+    thread stack."""
+    depth = 0
+    quoted = False
+    escaped = False
+    for char in frame:
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == 92:
+                escaped = True
+            elif char == 34:
+                quoted = False
+        elif char == 34:
+            quoted = True
+        elif char in (91, 123):
+            depth += 1
+            if depth > MAX_JSON_DEPTH:
+                raise ValueError(
