Avoid overflowing the OpenBSD thread stack on deeply nested bridge JSON.
Index: swival/python_bridge.py
--- swival/python_bridge.py.orig
+++ swival/python_bridge.py
@@ -29,6 +29,7 @@ ENV_VAR = "SWIVAL_PYTHON_BRIDGE"
 
 MAX_CALLS = 500
 MAX_REQUEST_BYTES = 1 << 20
+MAX_JSON_DEPTH = 128
 MAX_RESPONSE_BYTES = 10 << 20
 MAX_TOTAL_BYTES = 64 << 20
 # Keeps a looping snippet from growing the report without end.
@@ -44,6 +45,29 @@
 _FAILED = frozenset({"refused", "error", "timeout"})
 
 _HEADER = struct.Struct(">I")
+
+
+def _check_json_depth(frame: bytes) -> None:
+    """Bound C JSON decoder recursion before it can exhaust a thread stack."""
+    depth = 0
+    quoted = False
+    escaped = False
+    for char in frame:
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == 92:
+                escaped = True
+            elif char == 34:
+                quoted = False
+        elif char == 34:
+            quoted = True
+        elif char in (91, 123):
+            depth += 1
+            if depth > MAX_JSON_DEPTH:
+                raise ValueError("the request JSON nesting is too deep")
+        elif char in (93, 125):
+            depth -= 1
 
 
 class _ProtocolError(Exception):
