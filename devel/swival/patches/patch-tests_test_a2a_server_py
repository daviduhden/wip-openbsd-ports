+@pytest.mark.parametrize(
+    "headers",
+    [
+        {"host": "attacker.example"},
+        {"host": "attacker.example@127.0.0.1"},
+        {"host": "127.0.0.1:invalid"},
+        {"origin": "https://attacker.example"},
+        {"origin": "null"},
+        {"sec-fetch-site": "cross-site"},
+    ],
+)
+def test_browser_request_rejected_before_session(client, server, headers):
+    params = {"message": {"role": "user", "parts": [{"type": "text", "text": "run"}]}}
+    response = client.post("/", json=_jsonrpc("SendMessage", params), headers=headers)
+    assert response.status_code == 403
+    assert server._sessions == {}
+    assert server._tasks == {}
+
+
+@pytest.mark.parametrize("content_type", ["text/plain", "application/x-www-form-urlencoded"])
+def test_simple_post_cannot_start_session(client, server, content_type):
+    params = {"message": {"role": "user", "parts": [{"type": "text", "text": "run"}]}}
+    response = client.post(
+        "/",
+        content=json.dumps(_jsonrpc("SendMessage", params)),
+        headers={"content-type": content_type},
+    )
+    assert response.status_code == 403
+    assert server._sessions == {}
+    assert server._tasks == {}
+
+
+def test_same_origin_json_request_is_retained(client):
+    response = client.post(
+        "/", json=_jsonrpc("ListTasks", {}), headers={"origin": "http://127.0.0.1"}
+    )
+    assert response.status_code == 200
+
+
+def test_explicit_remote_bind_keeps_administrator_policy(_patch_session):
+    from starlette.testclient import TestClient
+
+    remote = A2aServer(
+        session_kwargs={"provider": "lmstudio", "base_dir": "/tmp"},
+        host="0.0.0.0",
+        auth_token="configured-token",
+    )
+    with TestClient(remote.app, base_url="https://agent.example") as client:
+        response = client.post(
+            "/",
+            json=_jsonrpc("ListTasks", {}),
+            headers={
+                "origin": "https://ui.example",
+                "authorization": "Bearer configured-token",
+            },
+        )
+        assert response.status_code == 200
