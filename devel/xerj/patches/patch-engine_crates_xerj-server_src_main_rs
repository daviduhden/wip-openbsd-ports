+#[cfg(target_os = "openbsd")]
+fn ensure_std_fds_open() -> std::io::Result<()> {
+    for fd in 0..3 {
+        // SAFETY: inspect descriptor state before starting any worker threads.
+        if unsafe { libc::fcntl(fd, libc::F_GETFD) } != -1 {
+            continue;
+        }
+        let error = std::io::Error::last_os_error();
+        if error.raw_os_error() != Some(libc::EBADF) {
+            return Err(error);
+        }
+        // SAFETY: the path is a static C string and all results are checked.
+        let null = unsafe { libc::open(c"/dev/null".as_ptr(), libc::O_RDWR) };
+        if null == -1 {
+            return Err(std::io::Error::last_os_error());
+        }
+        if null != fd {
+            if unsafe { libc::dup2(null, fd) } == -1 {
+                let error = std::io::Error::last_os_error();
+                // The process exits on this error; preserve the dup2 errno.
+                unsafe { libc::close(null) };
+                return Err(error);
+            }
+            if unsafe { libc::close(null) } == -1 {
+                return Err(std::io::Error::last_os_error());
+            }
+        }
+    }
+    Ok(())
+}
