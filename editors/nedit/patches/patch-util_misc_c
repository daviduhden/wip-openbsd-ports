Avoid the %n printf conversion when constructing geometry strings. Use
sprintf return values to advance the output pointer instead.

Index: util/misc.c
--- util/misc.c.orig
+++ util/misc.c
@@ -1491 +1491 @@ void CreateGeometryString(char *string,
-    	sprintf(ptr, "%d%n", width, &nChars);
+    	nChars = sprintf(ptr, "%d", width);
@@ -1495 +1495 @@ void CreateGeometryString(char *string,
-	sprintf(ptr, "x%d%n", height, &nChars);
+	nChars = sprintf(ptr, "x%d", height);
@@ -1500 +1500 @@ void CreateGeometryString(char *string,
-    	    sprintf(ptr, "-%d%n", -x, &nChars);
+    	    nChars = sprintf(ptr, "-%d", -x);
@@ -1502 +1502 @@ void CreateGeometryString(char *string,
-    	    sprintf(ptr, "+%d%n", x, &nChars);
+    	    nChars = sprintf(ptr, "+%d", x);
@@ -1507 +1507 @@ void CreateGeometryString(char *string,
-    	    sprintf(ptr, "-%d%n", -y, &nChars);
+    	    nChars = sprintf(ptr, "-%d", -y);
@@ -1509 +1509 @@ void CreateGeometryString(char *string,
-    	    sprintf(ptr, "+%d%n", y, &nChars);
+    	    nChars = sprintf(ptr, "+%d", y);
