Preserve argument ownership and reject an empty helper command.
Spawn piped image converters with checked file actions on OpenBSD.
Close pipe descriptors on failure without vfork-shared error state.

Index: src/exec.c
--- src/exec.c.orig
+++ src/exec.c
@@ -14,0 +15,44 @@
+#ifdef __OpenBSD__
+#include <fcntl.h>
+#include <spawn.h>
+
+extern char **environ;
+
+static int spawn_piped(char *const argv[], FILE **pipe_ret)
+{
+	posix_spawn_file_actions_t actions;
+	pid_t pid;
+	int fd[2];
+	int rv, cleanup;
+
+	if(pipe2(fd, O_CLOEXEC) == -1)
+		return errno;
+	rv = posix_spawn_file_actions_init(&actions);
+	if(!rv) {
+		rv = posix_spawn_file_actions_addclose(&actions, fd[0]);
+		if(!rv)
+			rv = posix_spawn_file_actions_adddup2(&actions,
+				fd[1], STDOUT_FILENO);
+		if(!rv && fd[1] != STDOUT_FILENO)
+			rv = posix_spawn_file_actions_addclose(&actions, fd[1]);
+		if(!rv)
+			rv = posix_spawnp(&pid, argv[0], &actions, NULL,
+				argv, environ);
+		cleanup = posix_spawn_file_actions_destroy(&actions);
+		if(!rv) rv = cleanup;
+	}
+	close(fd[1]);
+	if(rv) {
+		close(fd[0]);
+		return rv;
+	}
+	*pipe_ret = fdopen(fd[0], "r");
+	if(*pipe_ret == NULL) {
+		rv = errno;
+		close(fd[0]);
+		return rv;
+	}
+	return 0;
+}
+#endif
