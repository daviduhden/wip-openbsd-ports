Add LibreSSL compatibility helpers for ncrypto.
Map missing allocation, secure-heap and key-check helpers onto
the primitives LibreSSL actually provides.

Index: deps/ncrypto/libressl_compat.h
--- /dev/null
+++ deps/ncrypto/libressl_compat.h
@@ -0,0 +1,204 @@
+#pragma once
+
+// Compatibility helpers for building ncrypto against LibreSSL.
+//
+// LibreSSL implements most of the OpenSSL 1.1 API but intentionally does not
+// provide the OpenSSL 3 provider API.  It also omits a number of allocation
+// and validation helpers that Node's legacy OpenSSL backend still expects.
+// The helpers below map those interfaces onto the equivalent LibreSSL
+// primitives.  They are only compiled when LibreSSL is detected.
+
+#ifdef LIBRESSL_VERSION_NUMBER
+
+#include <openssl/bio.h>
+#include <openssl/bn.h>
+#include <openssl/crypto.h>
+#include <openssl/dh.h>
+#include <openssl/dsa.h>
+#include <openssl/ec.h>
+#include <openssl/evp.h>
+#include <openssl/rsa.h>
+
+#include <cstddef>
+#include <cstring>
+
+// LibreSSL defines OPENSSL_NO_DEPRECATED unconditionally but still exports
+// the low-level key objects used by Node's legacy backend.
+#ifndef OPENSSL_NO_OCB
+// LibreSSL does not define the OCB mode identifiers even though its
+// opensslfeatures.h leaves OPENSSL_NO_OCB unset.  Do not advertise a mode
+// that cannot be selected.
+#define OPENSSL_NO_OCB 1
+#endif
+
+#ifndef OPENSSL_NO_SM2
+// LibreSSL has no SM2 NIDs or EVP_PKEY identifier.
+#define OPENSSL_NO_SM2 1
+#endif
+
+static inline void* OPENSSL_zalloc(size_t size) {
+  void* ptr = OPENSSL_malloc(size);
+  if (ptr != nullptr) std::memset(ptr, 0, size);
+  return ptr;
+}
+
+static inline void* OPENSSL_memdup(const void* data, size_t size) {
+  if (data == nullptr) return nullptr;
+  void* ptr = OPENSSL_malloc(size);
+  if (ptr != nullptr) std::memcpy(ptr, data, size);
+  return ptr;
+}
+
+static inline void OPENSSL_clear_free(void* ptr, size_t size) {
+  if (ptr == nullptr) return;
+  if (size != 0) OPENSSL_cleanse(ptr, size);
+  OPENSSL_free(ptr);
+}
+
+// LibreSSL has no secure heap implementation.  These helpers preserve the
+// documented OpenSSL fallback used when the secure heap has not been
+// initialized: allocate ordinary memory and report it as non-secure.
+// Node refuses to start when --secure-heap is requested on such a build.
+static inline void* OPENSSL_secure_zalloc(size_t size) {
+  return OPENSSL_zalloc(size);
+}
+
+static inline void OPENSSL_secure_clear_free(void* ptr, size_t size) {
+  OPENSSL_clear_free(ptr, size);
+}
+
+static inline int CRYPTO_secure_allocated(const void* ptr) {
+  (void)ptr;
+  return 0;
+}
+
+static inline int CRYPTO_secure_malloc_initialized(void) { return 0; }
+
+static inline size_t CRYPTO_secure_used(void) { return 0; }
+
+static inline BIGNUM* BN_secure_new(void) { return BN_new(); }
+
+static inline const BIO_METHOD* BIO_s_secmem(void) { return BIO_s_mem(); }
+
+// LibreSSL has no generic EVP_PKEY_check/public_check entry points.  Validate
+// the key through the low-level primitives that are available.  Returning 0
+// here rejects the key; it never silently accepts malformed key material.
+static inline int ncrypto_evp_pkey_public_check(EVP_PKEY_CTX* ctx) {
+  EVP_PKEY* pkey = ctx == nullptr ? nullptr : EVP_PKEY_CTX_get0_pkey(ctx);
+  if (pkey == nullptr) return 0;
+
+  switch (EVP_PKEY_id(pkey)) {
+    case EVP_PKEY_RSA:
+    case EVP_PKEY_RSA_PSS: {
+      const RSA* rsa = EVP_PKEY_get0_RSA(pkey);
+      const BIGNUM* n = nullptr;
+      const BIGNUM* e = nullptr;
+      if (rsa == nullptr) return 0;
+      RSA_get0_key(rsa, &n, &e, nullptr);
+      if (n == nullptr || e == nullptr) return 0;
+      return BN_num_bits(n) >= 512 && BN_is_odd(e) ? 1 : 0;
+    }
+    case EVP_PKEY_EC: {
+      const EC_KEY* key = EVP_PKEY_get0_EC_KEY(pkey);
+      return key != nullptr && EC_KEY_check_key(key) == 1 ? 1 : 0;
+    }
+    case EVP_PKEY_DSA: {
+      const DSA* dsa = EVP_PKEY_get0_DSA(pkey);
+      const BIGNUM* p = nullptr;
+      const BIGNUM* q = nullptr;
+      const BIGNUM* g = nullptr;
+      const BIGNUM* pub = nullptr;
+      if (dsa == nullptr) return 0;
+      DSA_get0_pqg(dsa, &p, &q, &g);
+      DSA_get0_key(dsa, &pub, nullptr);
+      if (p == nullptr || q == nullptr || g == nullptr || pub == nullptr)
+        return 0;
+      if (BN_is_negative(pub) || BN_is_zero(pub) || BN_cmp(pub, p) >= 0)
+        return 0;
+      return 1;
+    }
+    case EVP_PKEY_DH: {
+      const DH* dh = EVP_PKEY_get0_DH(pkey);
+      const BIGNUM* p = nullptr;
+      const BIGNUM* q = nullptr;
+      const BIGNUM* g = nullptr;
+      const BIGNUM* pub = nullptr;
+      int codes = 0;
+      if (dh == nullptr) return 0;
+      DH_get0_pqg(dh, &p, &q, &g);
+      DH_get0_key(dh, &pub, nullptr);
+      if (p == nullptr || g == nullptr || pub == nullptr) return 0;
+      if (DH_check_pub_key(dh, pub, &codes) != 1) return 0;
+      if (codes & (DH_CHECK_PUBKEY_TOO_SMALL | DH_CHECK_PUBKEY_TOO_LARGE))
+        return 0;
+      return 1;
+    }
+    case EVP_PKEY_ED25519:
+    case EVP_PKEY_X25519:
+      // Raw keys have no structural parameters to validate.
+      return 1;
+    default:
+      // Refuse unknown key types rather than claiming they are valid.
+      return 0;
+  }
+}
+
+static inline int ncrypto_evp_pkey_private_check(EVP_PKEY_CTX* ctx) {
+  EVP_PKEY* pkey = ctx == nullptr ? nullptr : EVP_PKEY_CTX_get0_pkey(ctx);
+  if (pkey == nullptr) return 0;
+
+  switch (EVP_PKEY_id(pkey)) {
+    case EVP_PKEY_RSA:
+    case EVP_PKEY_RSA_PSS: {
+      const RSA* rsa = EVP_PKEY_get0_RSA(pkey);
+      return rsa != nullptr && RSA_check_key(rsa) == 1 ? 1 : 0;
+    }
+    case EVP_PKEY_EC: {
+      const EC_KEY* key = EVP_PKEY_get0_EC_KEY(pkey);
+      return key != nullptr && EC_KEY_check_key(key) == 1 ? 1 : 0;
+    }
+    case EVP_PKEY_DSA: {
+      const DSA* dsa = EVP_PKEY_get0_DSA(pkey);
+      const BIGNUM* p = nullptr;
+      const BIGNUM* q = nullptr;
+      const BIGNUM* g = nullptr;
+      const BIGNUM* pub = nullptr;
+      const BIGNUM* priv = nullptr;
+      if (dsa == nullptr) return 0;
+      DSA_get0_pqg(dsa, &p, &q, &g);
+      DSA_get0_key(dsa, &pub, &priv);
+      if (p == nullptr || q == nullptr || g == nullptr || priv == nullptr)
+        return 0;
+      if (BN_is_negative(priv) || BN_is_zero(priv) || BN_cmp(priv, q) >= 0)
+        return 0;
+      if (pub != nullptr &&
+          (BN_is_negative(pub) || BN_is_zero(pub) || BN_cmp(pub, p) >= 0))
+        return 0;
+      return 1;
+    }
+    case EVP_PKEY_DH: {
+      const DH* dh = EVP_PKEY_get0_DH(pkey);
+      const BIGNUM* p = nullptr;
+      const BIGNUM* q = nullptr;
+      const BIGNUM* g = nullptr;
+      const BIGNUM* pub = nullptr;
+      const BIGNUM* priv = nullptr;
+      int codes = 0;
+      if (dh == nullptr) return 0;
+      DH_get0_pqg(dh, &p, &q, &g);
+      DH_get0_key(dh, &pub, &priv);
+      if (p == nullptr || g == nullptr || priv == nullptr) return 0;
+      if (DH_check(dh, &codes) != 1) return 0;
+      if (codes != 0) return 0;
+      if (BN_is_negative(priv) || BN_is_zero(priv)) return 0;
+      return 1;
+    }
+    case EVP_PKEY_ED25519:
+    case EVP_PKEY_X25519:
+      return 1;
+    default:
+      return 0;
+  }
+}
+
+#endif  // LIBRESSL_VERSION_NUMBER
