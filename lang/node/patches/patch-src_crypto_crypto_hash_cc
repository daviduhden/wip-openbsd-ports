Handle the absence of XOF digests in LibreSSL.

Index: src/crypto/crypto_hash.cc
--- src/crypto/crypto_hash.cc.orig
+++ src/crypto/crypto_hash.cc
@@ -360,6 +360,10 @@ const EVP_MD* GetDigestImplementation(
