+#elif defined(LIBRESSL_VERSION_NUMBER)
+  // LibreSSL has no XOF implementation or matching reason code.
+  ERR_put_error(
+      ERR_LIB_EVP, 0, EVP_R_INVALID_DIGEST, __FILE__, __LINE__);
 #else
   EVPerr(EVP_F_EVP_DIGESTFINALXOF, EVP_R_NOT_XOF_OR_INVALID_LENGTH);
