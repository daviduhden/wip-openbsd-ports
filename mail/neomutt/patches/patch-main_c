 bool StartupComplete = false; ///< When the config has been read
 
+struct UnveilRule
+{
+  const char *path;
+  const char *permissions;
+  bool optional;
+  bool present;
+  char resolved[PATH_MAX];
+};
+
+static bool unveil_rule_resolve(struct UnveilRule *rule)
+{
+  if (!realpath(rule->path, rule->resolved))
+  {
+    if (rule->optional && ((errno == ENOENT) || (errno == ENOTDIR)))
+    {
+      rule->present = false;
+      return true;
+    }
+
+    fprintf(stderr, "neomutt: realpath %s: %s\n", rule->path,
+            strerror(errno));
+    return false;
+  }
+
+  if (mutt_str_equal(rule->resolved, "/"))
+  {
+    fprintf(stderr, "neomutt: refusing unveil rule for / (%s)\n", rule->path);
+    return false;
+  }
+
+  rule->present = true;
+  return true;
+}
+
+static bool unveil_rule_is_home_child(const struct UnveilRule *rule,
+                                      const char *home)
+{
+  const size_t home_len = strlen(home);
+
+  return rule->present && (strncmp(rule->resolved, home, home_len) == 0) &&
+         (rule->resolved[home_len] == '/');
+}
+
+static bool unveil_rule_apply(const struct UnveilRule *rule)
+{
+  if (!rule->present)
+    return true;
+
+  if (unveil(rule->resolved, rule->permissions) == -1)
+  {
+    fprintf(stderr, "neomutt: unveil %s: %s\n", rule->resolved,
+            strerror(errno));
+    return false;
+  }
+
+  return true;
+}
+
+/**
+ * neomutt_unveil - Restrict filesystem access to fixed OpenBSD paths
+ * @param home User's home directory
+ * @retval true Success
+ * @retval false Failure; caller must exit
+ *
+ * The policy intentionally does not follow arbitrary runtime paths.
+ */
+static bool neomutt_unveil(const char *home, char *tmpdir, size_t tmpdir_size)
+{
+  char resolved_home[PATH_MAX];
+  struct stat st = { 0 };
+
+  if ((getuid() == 0) || (geteuid() == 0))
+  {
+    fprintf(stderr, "neomutt: refusing to run sandboxed as root\n");
+    return false;
+  }
+
+  if (!home || !realpath(home, resolved_home) ||
+      mutt_str_equal(resolved_home, "/") ||
+      (stat(resolved_home, &st) == -1) || !S_ISDIR(st.st_mode))
+  {
+    fprintf(stderr, "neomutt: unable to resolve user's home directory\n");
+    return false;
+  }
+
+  int len = snprintf(tmpdir, tmpdir_size, "%s/.neomutt-tmp-XXXXXX",
+                     resolved_home);
+  if ((len < 0) || ((size_t) len >= tmpdir_size))
+  {
+    errno = ENAMETOOLONG;
+    fprintf(stderr, "neomutt: unable to create private temp directory: %s\n",
+            strerror(errno));
+    tmpdir[0] = '\0';
+    return false;
+  }
+
+  if (!mkdtemp(tmpdir))
+  {
+    fprintf(stderr, "neomutt: unable to create private temp directory: %s\n",
+            strerror(errno));
+    tmpdir[0] = '\0';
+    return false;
+  }
+
+  if ((setenv("TMPDIR", tmpdir, 1) == -1) ||
+      !envlist_set(&NeoMutt->env, "TMPDIR", tmpdir, true))
+  {
+    fprintf(stderr, "neomutt: unable to set private TMPDIR\n");
+    rmdir(tmpdir);
+    tmpdir[0] = '\0';
+    return false;
+  }
+
+  char home_write_paths[4][PATH_MAX];
+  const char *home_write_dirs[] = { "Mail", "mail", ".cache/neomutt",
+                                    ".local/share/neomutt" };
+  for (size_t i = 0; i < 4; i++)
+  {
+    int path_len = snprintf(home_write_paths[i], sizeof(home_write_paths[i]),
+                            "%s/%s", resolved_home, home_write_dirs[i]);
+    if ((path_len < 0) || ((size_t) path_len >= sizeof(home_write_paths[i])))
+    {
+      fprintf(stderr, "neomutt: home path is too long\n");
+      return false;
+    }
+  }
+
+  struct UnveilRule home_rules[] = {
+    { resolved_home, "r", false },
+    { tmpdir, "rwc", false },
+    { home_write_paths[0], "rwc", true },
+    { home_write_paths[1], "rwc", true },
+    { home_write_paths[2], "rwc", true },
+    { home_write_paths[3], "rwc", true },
+  };
+
+  struct UnveilRule rules[] = {
+    { "/var/mail", "rwc", true },
+    { "/dev/null", "rw", false },
+    { "/etc/hosts", "r", true },
+    { "/etc/host.conf", "r", true },
+    { "/etc/login.conf", "r", true },
+    { "/etc/mailcap", "r", true },
+    { "/etc/mime.types", "r", true },
+    { "/etc/protocols", "r", true },
+    { "/etc/pwd.db", "r", true },
+    { "/etc/passwd", "r", true },
+    { "/etc/resolv.conf", "r", true },
+    { "/etc/services", "r", true },
+    { "/etc/termcap", "r", true },
+    { "/etc/ssl/certs.pem", "r", true },
+    { "/etc/ssl/certs", "r", true },
+    { "/etc/ssl/cert.pem", "r", true },
+    { "/etc/localtime", "r", true },
+    { "/etc/xdg", "r", true },
+    { "/usr/etc/mailcap", "r", true },
+    { "/usr/etc/mime.types", "r", true },
+    { "/usr/local/etc/mailcap", "r", true },
+    { "/usr/local/etc/mime.types", "r", true },
+    { "/usr/local/share/terminfo", "r", true },
+    { "/usr/share/locale", "r", true },
+    { "/usr/share/terminfo", "r", true },
+    { "/usr/share/misc/termcap", "r", true },
+    { "/usr/share/zoneinfo", "r", true },
+    { "/usr/lib/terminfo", "r", true },
+    { SYSCONFDIR, "r", true },
+    { PKGDATADIR, "r", true },
+    { MUTTLOCALEDIR, "r", true },
+#ifdef USE_SASL_CYRUS
+    { "/etc/sasl2", "r", true },
+    { "/var/run/saslauthd", "w", true },
+    { "/usr/local/etc/sasl2", "r", true },
+    { "/usr/local/lib/sasl2", "r", true },
+#endif
+  };
+
+  const size_t home_rule_count = sizeof(home_rules) / sizeof(home_rules[0]);
+  for (size_t i = 0; i < home_rule_count; i++)
+  {
+    if (!unveil_rule_resolve(&home_rules[i]))
+      return false;
+    if ((i > 1) && home_rules[i].present &&
+        !unveil_rule_is_home_child(&home_rules[i], resolved_home))
+    {
+      fprintf(stderr, "neomutt: refusing writable path outside HOME: %s\n",
+              home_rules[i].resolved);
+      return false;
+    }
+  }
+
+  const size_t rule_count = sizeof(rules) / sizeof(rules[0]);
+  for (size_t i = 0; i < rule_count; i++)
+  {
+    if (!unveil_rule_resolve(&rules[i]))
+      return false;
+  }
+
+  for (size_t i = 0; i < home_rule_count; i++)
+  {
+    if (!unveil_rule_apply(&home_rules[i]))
+      return false;
+  }
+  for (size_t i = 0; i < rule_count; i++)
+  {
+    if (!unveil_rule_apply(&rules[i]))
+      return false;
+  }
+
+  if (unveil(NULL, NULL) == -1)
+  {
+    fprintf(stderr, "neomutt: unveil lock: %s\n", strerror(errno));
+    return false;
+  }
+
+  return true;
+}
