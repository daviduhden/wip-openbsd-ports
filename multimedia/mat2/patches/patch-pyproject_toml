Install the manual page under man/man1 rather than share/man/man1, and stop
setuptools from installing non-Python directories such as doc/ into
site-packages through implicit namespace package discovery.  Namespace
discovery is disabled upstream in bdf641b5fda40, after this release.

Index: pyproject.toml
--- pyproject.toml.orig
+++ pyproject.toml
@@ -38,9 +38,10 @@ script-files = ["mat2"]
 
 [tool.setuptools.packages.find]
 exclude = ["tests*"]
+namespaces = false
 
 [tool.setuptools.data-files]
-"share/man/man1" = ["doc/mat2.1"]
+"man/man1" = ["doc/mat2.1"]
 
 [tool.ruff]
 target-version = "py38"
