#!/bin/ksh

daemon="${TRUEPREFIX}/bin/monero-lws-daemon"
daemon_user="_monerod"
daemon_flags="--db-path=${LOCALSTATEDIR}/lib/monero-lws \
	--rest-server=http://127.0.0.1:8443"
daemon_logger="daemon.info"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

# monero-lws-daemon needs a monerod(1) with the ZMQ RPC interface enabled;
# it connects to tcp://127.0.0.1:18082 by default.  Pass --sub here and
# --zmq-pub to monerod for block notifications instead of polling.
#
# The wallet REST API listens on localhost only.  Add one --rest-server
# argument for every further listener; https:// endpoints use a self-signed
# certificate unless --rest-ssl-key and --rest-ssl-certificate are given.
# Use --config-file=<path> for options that should not show up in the process
# list, such as --lws-server-pass.  Further flags belong in rc.conf.local(8).
rc_cmd "$1"
