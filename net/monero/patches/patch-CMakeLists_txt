Use LLVM 22 for C and C++, LLVM MC for raw assembly, and
OpenBSD libedit for readline-compatible console editing. Set C++17
and conservative release flags, and detect OpenBSD system libraries.

Index: CMakeLists.txt
--- CMakeLists.txt.orig
+++ CMakeLists.txt
@@ -46,6 +46,20 @@ endif()
 cmake_minimum_required(VERSION 3.5)
 message(STATUS "CMake version ${CMAKE_VERSION}")
 
+if(CMAKE_HOST_SYSTEM_NAME STREQUAL "OpenBSD")
+  find_program(MONERO_CLANG_EXECUTABLE clang-22
+    HINTS "$ENV{LOCALBASE}/bin")
+  find_program(MONERO_CLANGXX_EXECUTABLE clang++-22
+    HINTS "$ENV{LOCALBASE}/bin")
+  if(NOT MONERO_CLANG_EXECUTABLE OR NOT MONERO_CLANGXX_EXECUTABLE)
+    message(FATAL_ERROR "devel/llvm/22 is required to build Monero")
+  endif()
+  set(CMAKE_C_COMPILER "${MONERO_CLANG_EXECUTABLE}" CACHE FILEPATH
+    "LLVM 22 C compiler" FORCE)
+  set(CMAKE_CXX_COMPILER "${MONERO_CLANGXX_EXECUTABLE}" CACHE FILEPATH
+    "LLVM 22 C++ compiler" FORCE)
+endif()
+
 project(monero)
 
 option (USE_CCACHE "Use ccache if a usable instance is found" ON)
@@ -92,11 +106,32 @@ endif()
 
 enable_language(C ASM)
 
-# Require C11/C++11 and disable extensions for all targets
+if(CMAKE_SYSTEM_NAME STREQUAL "OpenBSD")
+  find_program(MONERO_LLVM_MC_EXECUTABLE llvm-mc-22
+    HINTS "$ENV{LOCALBASE}/bin")
+  if(NOT MONERO_LLVM_MC_EXECUTABLE)
+    message(FATAL_ERROR "devel/llvm/22 llvm-mc is required for ASM builds")
+  endif()
+  execute_process(COMMAND "${CMAKE_C_COMPILER}" -dumpmachine
+    OUTPUT_VARIABLE MONERO_ASM_TARGET_TRIPLE
+    RESULT_VARIABLE MONERO_ASM_TRIPLE_RESULT
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+  if(NOT MONERO_ASM_TRIPLE_RESULT EQUAL 0)
+    message(FATAL_ERROR "Could not determine the OpenBSD target triple")
+  endif()
+  # Raw .s inputs need no preprocessing; .S files use Clang's LLVM MC.
+  string(CONCAT CMAKE_ASM_COMPILE_OBJECT
+    "${MONERO_LLVM_MC_EXECUTABLE} "
+    "-triple=${MONERO_ASM_TARGET_TRIPLE} "
+    "-filetype=obj "
+    "-o <OBJECT> <SOURCE>")
+endif()
+
+# Require C11/C++17 and disable extensions for all targets
 set(CMAKE_C_STANDARD 11)
 set(CMAKE_C_STANDARD_REQUIRED ON)
 set(CMAKE_C_EXTENSIONS OFF)
-set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
 
