+//! A kernel DNS proposal is not proof of resolver policy enforcement.
+//! talpid-openbsd implements publication/withdrawal through RTM_PROPOSAL;
+//! resolvd acknowledgement/restart, unwind and PF DNS restrictions remain.
+use super::ResolvedDnsConfig;
+
+#[derive(Debug, thiserror::Error)]
+#[error("OpenBSD resolver lifecycle and leak protection are incomplete")]
+pub struct Error;
+
+pub struct DnsMonitor;
+
+impl DnsMonitor {
+    pub fn new() -> Result<Self, Error> { Err(Error) }
+    pub fn set(&mut self, _interface: &str, _config: ResolvedDnsConfig) -> Result<(), Error> { Err(Error) }
+    pub fn reset(&mut self) -> Result<(), Error> { Err(Error) }
+    pub fn reset_before_interface_removal(&mut self) -> Result<(), Error> { Err(Error) }
+}
