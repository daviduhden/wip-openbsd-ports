Remove torrc template lines for optional transport plugins whose
executables are not installed; this prevents Tor from failing
configuration validation for unavailable bridges.

Index: cli/onionshare_cli/onion.py
--- cli/onionshare_cli/onion.py.orig	2026-10-16 06:50:17.000000000 +0200
+++ cli/onionshare_cli/onion.py	2026-10-22 13:07:15.265099823 +0200
@@ -328,6 +328,16 @@ class Onion(object):
             torrc_template = torrc_template.replace(
                 "{{socks_port}}", str(self.tor_socks_port)
             )
+            for placeholder, executable in (
+                ("{{obfs4proxy_path}}", self.obfs4proxy_file_path),
+                ("{{snowflake_path}}", self.snowflake_file_path),
+                ("{{webtunnel_path}}", self.webtunnel_file_path),
+            ):
+                if not executable:
+                    torrc_template = "".join(
+                        line for line in torrc_template.splitlines(keepends=True)
+                        if placeholder not in line
+                    )
             torrc_template = torrc_template.replace(
                 "{{obfs4proxy_path}}", str(self.obfs4proxy_file_path)
             )
