Reject TLS version policies that the SSL backend cannot apply.
Release the client SSL context before returning policy failures.

Index: src/core/tsi/ssl_transport_security.cc
--- src/core/tsi/ssl_transport_security.cc.orig
+++ src/core/tsi/ssl_transport_security.cc
@@ -2040,14 +2040,20 @@ static tsi_result tsi_set_min_and_max_tl
   // only exist in this version range.
   switch (min_tls_version) {
     case tsi_tls_version::TSI_TLS1_2:
-      SSL_CTX_set_min_proto_version(ssl_context, TLS1_2_VERSION);
+      if (SSL_CTX_set_min_proto_version(ssl_context, TLS1_2_VERSION) != 1) {
+        LOG(ERROR) << "Could not set minimum TLS version.";
+        return TSI_FAILED_PRECONDITION;
+      }
       break;
 #if defined(TLS1_3_VERSION)
     // If the library does not support TLS 1.3 and the caller requests a
     // minimum of TLS 1.3, then return an error because the caller's request
     // cannot be satisfied.
     case tsi_tls_version::TSI_TLS1_3:
-      SSL_CTX_set_min_proto_version(ssl_context, TLS1_3_VERSION);
+      if (SSL_CTX_set_min_proto_version(ssl_context, TLS1_3_VERSION) != 1) {
+        LOG(ERROR) << "Could not set minimum TLS version.";
+        return TSI_FAILED_PRECONDITION;
+      }
       break;
 #endif
     default:
@@ -2058,15 +2064,24 @@ static tsi_result tsi_set_min_and_max_tl
   // Set the max TLS version of the SSL context.
   switch (max_tls_version) {
     case tsi_tls_version::TSI_TLS1_2:
-      SSL_CTX_set_max_proto_version(ssl_context, TLS1_2_VERSION);
+      if (SSL_CTX_set_max_proto_version(ssl_context, TLS1_2_VERSION) != 1) {
+        LOG(ERROR) << "Could not set maximum TLS version.";
+        return TSI_FAILED_PRECONDITION;
+      }
       break;
     case tsi_tls_version::TSI_TLS1_3:
 #if defined(TLS1_3_VERSION)
-      SSL_CTX_set_max_proto_version(ssl_context, TLS1_3_VERSION);
+      if (SSL_CTX_set_max_proto_version(ssl_context, TLS1_3_VERSION) != 1) {
+        LOG(ERROR) << "Could not set maximum TLS version.";
+        return TSI_FAILED_PRECONDITION;
+      }
 #else
       // If the library does not support TLS 1.3, then set the max TLS version
       // to TLS 1.2 instead.
-      SSL_CTX_set_max_proto_version(ssl_context, TLS1_2_VERSION);
+      if (SSL_CTX_set_max_proto_version(ssl_context, TLS1_2_VERSION) != 1) {
+        LOG(ERROR) << "Could not set maximum TLS version.";
+        return TSI_FAILED_PRECONDITION;
+      }
 #endif
       break;
     default:
@@ -3340,7 +3355,10 @@ tsi_result tsi_create_ssl_client_handsha

   result = tsi_set_min_and_max_tls_versions(
       ssl_context, options->min_tls_version, options->max_tls_version);
-  if (result != TSI_OK) return result;
+  if (result != TSI_OK) {
+    SSL_CTX_free(ssl_context);
+    return result;
+  }

   impl = new tsi_ssl_client_handshaker_factory();
   tsi_ssl_handshaker_factory_init(&impl->base);
