-resumeAgentClient c = atomically $ writeTVar (active c) True
-{-# INLINE resumeAgentClient #-}
+resumeAgentClient c@AgentClient {acThread, acThreadDone, agentEnv} = withAgentLifecycle c $ do
+  atomically $ writeTVar (active c) True
+  readTVarIO acThread >>= \case
+    Just _ -> pure ()
+    Nothing -> do
+      atomically $ do
+        void $ tryTakeTMVar acThreadDone
+        -- A stopped session has no operations left to complete. In particular,
+        -- do not carry a suspended database gate into the new supervisor.
+        writeTVar (agentState c) ASForeground
+        forM_ agentOperations $ \op -> writeTVar (op c) $ AgentOpState False 0
+      let run = runReaderT (runAgentThreads c) agentEnv
+          done _ = disconnectAgentClient c `E.finally` atomically (putTMVar acThreadDone ())
+      t <- run `forkFinallyUnmasked` done
+      atomically . writeTVar acThread . Just =<< mkWeakThreadId t
+
+withAgentLifecycle :: AgentClient -> IO a -> IO a
+withAgentLifecycle AgentClient {acLifecycleLock} =
+  E.bracket_ (atomically $ takeTMVar acLifecycleLock) (atomically $ putTMVar acLifecycleLock ()) . E.mask_
 
