+-- Stop all agent threads, including the statistics finalizer, before its
+-- owner closes or replaces the store. Unlike dispose, this permits restart.
+stopAgentClient :: AgentClient -> IO ()
+stopAgentClient c = withAgentLifecycle c $ stopAgentClient_ c
+
+stopAgentClient_ :: AgentClient -> IO ()
+stopAgentClient_ c@AgentClient {acThread, acThreadDone} = do
+  atomically $ writeTVar (active c) False
+  t_ <- readTVarIO acThread
+  forM_ t_ $ \t -> do
+    deRefWeak t >>= mapM_ killThread
+    atomically $ readTMVar acThreadDone
+    atomically $ writeTVar acThread Nothing
+
