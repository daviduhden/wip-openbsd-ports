+-- Publish thread ownership while masked, but do not make a long-lived child
+-- inherit that mask. Keep its completion callback masked, like forkFinally.
+forkFinallyUnmasked :: MonadUnliftIO m => m a -> (Either E.SomeException a -> m ()) -> m C.ThreadId
+forkFinallyUnmasked action done = withRunInIO $ \run ->
+  E.mask_ $ C.forkIOWithUnmask $ \unmask -> E.try (unmask $ run action) >>= run . done
