+-- Keep /stop restartable and serialize it with controller startup.
+withChatLifecycle :: CM' a -> CM' a
+withChatLifecycle action = do
+  lock <- asks chatLifecycleLock
+  E.bracket_ (atomically $ takeTMVar lock) (atomically $ putTMVar lock ()) action
+
+-- Publish ownership before a startup job can touch either database.
+forkChatBackground :: CM' () -> CM' ()
+forkChatBackground action = E.mask_ $ do
+  ChatController {agentAsync, chatStartThreads} <- ask
+  gate <- newEmptyTMVarIO
+  a <- asyncWithUnmask $ \unmask -> unmask $ whenM (atomically $ takeTMVar gate) action
+  atomically $ do
+    started <- isJust <$> readTVar agentAsync
+    when started $ modifyTVar' chatStartThreads (a :)
+    putTMVar gate started
