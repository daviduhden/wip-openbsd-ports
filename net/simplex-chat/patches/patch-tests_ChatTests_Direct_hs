+    checkEndedCall :: TestCC -> Int -> String -> (UTCTime, UTCTime) -> UTCTime -> IO ()
+    checkEndedCall cc direction label (connectedBefore, connectedAfter) endRequested = do
+      cc ##> "/_get chat @2 count=100"
+      items <- chat <$> getTermLine cc
+      observedAt <- getCurrentTime
+      take (length chatFeatures) items `shouldBe` chatFeatures
+      case drop (length chatFeatures) items of
+        [(dir, call)] -> do
+          dir `shouldBe` direction
+          case stripPrefix (label <> " call: ended (") call of
+            Just duration -> case reads duration of
+              [(minutes, ':' : rest)] -> case reads rest of
+                [(seconds, ")")] -> do
+                  minutes `shouldSatisfy` (>= (0 :: Int))
+                  seconds `shouldSatisfy` (\n -> n >= 0 && n < (60 :: Int))
+                  let elapsed = 60 * minutes + seconds
+                      lower = max 0 $ floor $ diffUTCTime endRequested connectedAfter
+                      upper = ceiling $ diffUTCTime observedAt connectedBefore
+                  elapsed `shouldSatisfy` (\n -> n >= lower && n <= upper)
+                _ -> expectationFailure $ "invalid call seconds: " <> duration
+              _ -> expectationFailure $ "invalid call duration: " <> duration
+            _ -> expectationFailure $ "call has not ended: " <> call
+        _ -> expectationFailure $ "unexpected call history: " <> show items

