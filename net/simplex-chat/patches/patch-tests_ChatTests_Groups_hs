+-- The owner-signed roster snapshot and the owner intros are delivered
+-- asynchronously after a member joins and there is no terminal event for an
+-- applied roster, so the row may not exist yet under load.  Poll the database
+-- with a bounded timeout (30s, matching the terminal/server waits) before
+-- asserting the applied role.  Only use this for positive checks; an absent
+-- row ("Nothing") is synchronous and must be asserted with checkMemberRow.
+checkMemberRowEventually :: HasCallStack => TestCC -> T.Text -> Maybe T.Text -> IO ()
+checkMemberRowEventually cc name expectedRole = go (300 :: Int)
+  where
+    go 0 = checkMemberRow cc name expectedRole
+    go n = do
+      roles <- withCCTransaction cc $ \db ->
+        DB.query db "SELECT member_role FROM group_members WHERE local_display_name = ?" (Only name) :: IO [Only T.Text]
+      if map (\(Only r) -> r) roles == maybeToList expectedRole
+        then pure ()
+        else threadDelay 100000 >> go (n - 1)
