+-- The host learns that two members are directly connected from their
+-- x.grp.mem.con messages; when those arrive they update the member relations
+-- vector to MRSubjectConnected/MRConnected.  Breaking the direct connection and
+-- forcing MRIntroduced before those notifications are processed races with
+-- them: the later notification overwrites MRIntroduced with a "connected"
+-- state, forwarding is disabled and the test times out with no output.  Wait
+-- until both relations are already MRConnected (so no later notification can
+-- change them), then force MRIntroduced.  Bounded at 30s.
+waitForGroupMembersConnected :: TestCC -> TestCC -> TestCC -> IO ()
+waitForGroupMembersConnected host invitee1 invitee2 = go (300 :: Int)
+  where
+    go 0 = pure ()
+    go n = do
+      invitee1Name <- userName invitee1
+      invitee2Name <- userName invitee2
+      connected <- withCCTransaction host $ \db -> do
+        [(i1, v1)] <- DB.query db
+          "SELECT index_in_group, member_relations_vector FROM group_members WHERE local_display_name = ?"
+          (Only invitee1Name)
+        [(i2, v2)] <- DB.query db
+          "SELECT index_in_group, member_relations_vector FROM group_members WHERE local_display_name = ?"
+          (Only invitee2Name)
+        pure $ getRelation i2 (fromMaybe B.empty v1) == MRConnected && getRelation i1 (fromMaybe B.empty v2) == MRConnected
+      if connected then pure () else threadDelay 100000 >> go (n - 1)
