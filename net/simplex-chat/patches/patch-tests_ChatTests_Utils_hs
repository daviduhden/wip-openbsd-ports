+getProfilePictureByName cc displayName = go (300 :: Int)
+  where
+    -- The profile image is delivered by an asynchronous profile update after
+    -- the member joins.  Poll for a bounded time and decode the nullable
+    -- column as Maybe so a not-yet-received image returns Nothing instead of
+    -- failing with a NULL-to-Text conversion error.
+    go 0 = queryImage
+    go n = do
+      image <- queryImage
+      maybe (threadDelay 100000 >> go (n - 1)) (pure . Just) image
+    queryImage = do
+      rows <-
+        withTransaction (chatStore $ chatController cc) $ \db ->
+          DB.query db "SELECT image FROM contact_profiles WHERE display_name = ? LIMIT 1" (Only displayName) :: IO [Only (Maybe String)]
+      pure $ case rows of
+        [Only image] -> image
+        _ -> Nothing
 
