+    -- failing with a NULL-to-Text conversion error.
+    go 0 = queryImage
+    go n = do
+      image <- queryImage
+      maybe (threadDelay 100000 >> go (n - 1)) (pure . Just) image
+    queryImage = do
+      rows <-
+        withTransaction (chatStore $ chatController cc) $ \db ->
+          DB.query db "SELECT image FROM contact_profiles WHERE display_name = ? LIMIT 1" (Only displayName) :: IO [Only (Maybe String)]
