+-- Consume up to as many optional lines as suffixes are given.
+--
+-- A line that arrives within the short window must end with one of the given
+-- suffixes; when no such line arrives the queue is left untouched.  Used for
+-- the member-connected group items that memberConnectedChatItem creates on the
+-- host: they are chat items printed when a member's group connection is
+-- established, so their position relative to the member relation vector the
+-- callers poll is not fixed, while the examples read the host's output next.
+-- Any other output is a genuine failure.
+(<??) :: HasCallStack => TestCC -> [String] -> Expectation
+cc <?? suffixes = go (length suffixes)
+  where
+    go 0 = pure ()
+    go n = do
+      ml <- timeout 500000 (dropTime <$> getTermLine cc)
+      case ml of
+        Nothing -> pure ()
+        Just l
+          | any (`isSuffixOf` l) suffixes -> go (n - 1)
+          | otherwise -> expectationFailure $ "unexpected output: " <> show l
+
 (<#) :: HasCallStack => TestCC -> String -> Expectation
 cc <# line = (dropTime <$> getTermLine' (Just line) cc) `shouldReturn` line
 
