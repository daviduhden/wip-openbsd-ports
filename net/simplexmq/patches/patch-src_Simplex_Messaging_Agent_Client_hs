+-- Only invalidate failures that predate this explicit request. Callers that
+-- share an in-flight connection must all observe its result, otherwise they
+-- could keep invalidating each other's fresh failures and retry indefinitely.
+-- Background loops and permanent errors retain their configured cache TTL.
+discardInteractiveError :: Ord k => NetworkRequestMode -> k -> TMap k (SessionVar (Either (AgentErrorType, Maybe UTCTime) a)) -> STM ()
+discardInteractiveError nm key clients = case nm of
+  NRMInteractive' _ -> TM.lookup key clients >>= mapM_ (\v -> do
+    cached <- tryReadTMVar $ sessionVar v
+    case cached of
+      Just (Left (e, _)) | temporaryAgentError e -> removeSessVar v key clients
+      _ -> pure ())
+  NRMBackground -> pure ()

