+-- A retry may outlive deletion of its connection or replacement of its queue.
+isSndMsgPending :: DB.Connection -> ConnId -> SndQueue -> InternalId -> IO Bool
+isSndMsgPending db connId SndQueue {dbQueueId} msgId =
+  not . null <$> (DB.query db
+    "SELECT 1 FROM snd_message_deliveries WHERE conn_id = ? AND snd_queue_id = ? AND internal_id = ? AND failed = 0"
+    (connId, dbQueueId, msgId) :: IO [Only Int])
+
