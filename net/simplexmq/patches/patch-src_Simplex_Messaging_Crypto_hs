+-- | Build a Poly1305 key from the 32-byte key material generated by
+-- xSalsa20.  crypton >= 2.0 checks the key length in 'Poly1305.key';
+-- the material here is always 32 bytes, so a failure cannot happen.
+poly1305Key :: ByteString -> Poly1305.Key
+poly1305Key = CE.throwCryptoError . Poly1305.key
+{-# INLINE poly1305Key #-}
