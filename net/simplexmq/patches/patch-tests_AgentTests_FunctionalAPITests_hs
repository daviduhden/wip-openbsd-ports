+-- Restart tests intentionally overlap sessions and close/reopen databases.
+-- Register every acquisition, including replacements, so an assertion failure
+-- cannot leave a live agent behind when Test.hs removes tests/tmp.
+withAgentSessions :: ((IO AgentClient -> IO AgentClient) -> IO a) -> IO a
+withAgentSessions action = E.bracket (newIORef []) cleanup $ \agents ->
+  action $ \acquire -> E.mask_ $ do
+    a <- acquire
+    modifyIORef' agents (a :)
+    pure a
+  where
+    cleanup agents = readIORef agents >>= foldr (E.finally . dispose) (pure ())
+    dispose a = do
+      closed <- readTVarIO $ dbClosed $ store $ agentEnv a
+      unless closed $ disposeAgentClient a
