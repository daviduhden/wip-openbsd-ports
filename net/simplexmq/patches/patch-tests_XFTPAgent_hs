+-- With a one-element queue, leaving the first progress event queued blocks
+-- the uploader at its next notification. It cannot finish all six chunks
+-- and remove the source before the test disposes the agent.
+holdSndProgress :: HasCallStack => AgentClient -> SndFileId -> IO ()
+holdSndProgress c sfId = do
+  (_, sfId', AEvt _ event) <- atomically $ peekTBQueue (subQ c)
+  if skipTestEvent True event
+    then atomically (readTBQueue $ subQ c) >> holdSndProgress c sfId
+    else case event of
+      SFPROG sent total -> do
+        sfId' `shouldBe` sfId
+        sent `shouldSatisfy` (\n -> n > 0 && n < total)
+      _ -> expectationFailure $ "expected partial upload progress, got " <> show event
 
