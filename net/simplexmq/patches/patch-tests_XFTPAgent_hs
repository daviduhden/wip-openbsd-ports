+-- Leave the fifth of six progress events queued. The last replica is then
+-- committed, but final progress and completion cannot fit in subQ.
+testXFTPAgentSendCompleteRestore :: HasCallStack => IO ()
+testXFTPAgentSendCompleteRestore = withGlobalLogging logCfgNoLogs $ do
+  filePath <- createRandomFile
+  (sfId, prefixPath, encPath) <- withXFTPServerStoreLogOn $ \_ ->
+    withAgent 1 agentCfg {tbqSize = 1} initAgentServers testDB $ \sndr -> do
+      sfId <- runRight $ do
+        xftpStartWorkers sndr (Just senderFiles)
+        xftpSendFile sndr 1 (CF.plain filePath) 2
+      replicateM_ 4 $ holdSndProgress sndr sfId >> atomically (readTBQueue $ subQ sndr)
+      holdSndProgress sndr sfId
+      waitSndFileState sndr sfId $ \sf ->
+        sf.status == FT.SFSUploading && length sf.chunks == 6 && all chunkUploaded sf.chunks
+      (prefixPath, encPath) <- sndFilePaths sndr sfId
+      pure (sfId, prefixPath, encPath)
+
+  -- Completing an already uploaded file must not need the server.
+  rfd <- withAgent 2 agentCfg initAgentServers testDB $ \sndr -> do
+    runRight_ $ xftpStartWorkers sndr (Just senderFiles)
+    sfGet sndr `shouldRespond` ("", sfId, SFPROG (mb 18) (mb 18))
+    ("", sfId', SFDONE _ [rfd, _]) <- sfGet sndr
+    sfId' `shouldBe` sfId
+    assertSndComplete sndr sfId
+    doesDirectoryExist prefixPath `shouldReturn` False
+    doesFileExist encPath `shouldReturn` False
+    pure rfd
+
+  withXFTPServerStoreLogOn $ \_ ->
+    withAgent 3 agentCfg initAgentServers testDB2 $ \rcp ->
+      runRight_ . void $ testReceive rcp rfd filePath
+  where
+    chunkUploaded chunk = any uploaded chunk.replicas
+    uploaded rep = rep.replicaStatus == FT.SFRSUploaded
+
+getSndFileState :: HasCallStack => AgentClient -> SndFileId -> IO FT.SndFile
+getSndFileState c sfId = runRight $ withAgentEnv c $ AC.withStore c $ \db -> getSndFileByEntityId db sfId
+
+waitSndFileState :: HasCallStack => AgentClient -> SndFileId -> (FT.SndFile -> Bool) -> IO ()
+waitSndFileState c sfId ready = loop `shouldRespond` ()
+  where
+    loop = do
+      f <- getSndFileState c sfId
+      f.status `shouldNotBe` FT.SFSError
+      unless (ready f) $ threadDelay 10000 >> loop
+
+sndFilePaths :: HasCallStack => AgentClient -> SndFileId -> IO (FilePath, FilePath)
+sndFilePaths c sfId = do
+  sf <- getSndFileState c sfId
+  case sf.prefixPath of
+    Just p -> do
+      let path = senderFiles </> p
+          encPath = path </> "xftp.encrypted"
+      doesDirectoryExist path `shouldReturn` True
+      doesFileExist encPath `shouldReturn` True
+      pure (path, encPath)
+    Nothing -> expectationFailure "pending send has no prefix path in the store" >> fail "missing send prefix"
+
+assertSndComplete :: HasCallStack => AgentClient -> SndFileId -> IO ()
+assertSndComplete c sfId = do
+  sf <- getSndFileState c sfId
+  sf.status `shouldBe` FT.SFSComplete
+  sf.prefixPath `shouldBe` Nothing
+
+-- With a one-element queue, leaving progress queued blocks the uploader at
+-- its next notification. Use a bounded wait and retain the event until stop.
+holdSndProgress :: HasCallStack => AgentClient -> SndFileId -> IO ()
+holdSndProgress c sfId = loop `shouldRespond` ()
+  where
+    loop = do
+      (_, sfId', AEvt _ event) <- atomically $ peekTBQueue (subQ c)
+      if skipTestEvent True event
+        then atomically (readTBQueue $ subQ c) >> loop
+        else case event of
+          SFPROG sent total -> do
+            sfId' `shouldBe` sfId
+            sent `shouldSatisfy` (\n -> n > 0 && n < total)
+          _ -> expectationFailure $ "expected partial upload progress, got " <> show event
+
