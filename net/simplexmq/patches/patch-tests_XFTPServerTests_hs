+testPausedFileChunkUpload :: AFStoreType -> Expectation
+testPausedFileChunkUpload = xftpTest $ \c -> runRight_ $ do
+  g <- liftIO C.newRandom
+  (sndKey, spKey) <- atomically $ C.generateAuthKeyPair C.SEd25519 g
+  (rcvKey, rpKey) <- atomically $ C.generateAuthKeyPair C.SEd25519 g
+  -- Exceed the HTTP/2 stream window as well as pausing the producer below.
+  bytes <- atomically $ C.randomBytes (kb 1024) g
+  let size = fromIntegral $ B.length bytes
+      digest = LC.sha256Hash $ LB.fromStrict bytes
+      file = FileInfo {sndKey, size, digest}
+  (sId, [rId]) <- createXFTPChunk c spKey file [rcvKey] Nothing
+  liftIO $ do
+    command <- either (error . show) pure $ xftpEncodeAuthTransmission (thParams c) spKey ("", sId, FileCmd SFSender FPUT)
+    let path = xftpServerFiles </> B.unpack (B64.encode $ unEntityId sId)
+        firstBlockSize = 16384
+        waitForFirstBlock = do
+          exists <- doesFileExist path
+          written <- if exists then getFileSize path else pure 0
+          unless (written >= fromIntegral firstBlockSize) $ threadDelay 1000 >> waitForFirstBlock
+        req = H2.requestStreaming "POST" "/" [] $ \send flush -> do
+          send $ byteString command
+          send $ byteString $ B.take firstBlockSize bytes
+          -- Do not explicitly flush: once the producer is blocked, the
+          -- sender must flush its partial buffer. Otherwise the server waits
+          -- for the tail of its first file block and neither side can advance.
+          timeout 5000000 waitForFirstBlock `shouldReturn` Just ()
+          send $ byteString $ B.drop firstBlockSize bytes
+          flush
+    resp <- either (error . show) pure =<< HC.sendRequest (http2Client c) req (Just 10000000)
+    case xftpDecodeTClient (thParams c) (bodyHead $ HC.respBody resp) of
+      Right (_, _, Right FROk) -> pure ()
+      result -> expectationFailure $ "upload response: " <> show result
+    readChunk sId `shouldReturn` bytes
+  downloadXFTPChunk g c rpKey rId $ XFTPRcvChunkSpec "tests/tmp/received-paused-upload" size digest
+  liftIO $ B.readFile "tests/tmp/received-paused-upload" `shouldReturn` bytes
