   log_warn(LD_GENERAL,
@@ -2370,7 +2429,11 @@ sandbox_cfg_allow_rename(sandbox_cfg_t *
 int
 sandbox_is_active(void)
 {
+#ifdef __OpenBSD__
+  return openbsd_sandbox_active != 0;
