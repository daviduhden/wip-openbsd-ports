#!/bin/ksh

daemon="${TRUEPREFIX}/bin/tor"
daemon_user="_tor"
daemon_flags="--RunAsDaemon 0"
daemon_timeout=60

# Run tor in the foreground under rc.subr as _tor. The packaged torrc still
# contains `User _tor` and `RunAsDaemon 1`; the command-line flag overrides
# the latter, and tor accepts the already-dropped user. Binding ports below
# 1024 requires an explicit configuration change and a privileged wrapper.
. /etc/rc.d/rc.subr

rc_stop_signal=INT

rc_configtest() {
	rc_exec "${daemon} ${daemon_flags} --verify-config"
}

rc_cmd "$1"
