#!/bin/ksh

daemon="${TRUEPREFIX}/bin/tor"
daemon_user="_tor"
daemon_timeout=60

# Run tor as the unprivileged _tor user in the foreground; rc.subr starts it
# in the background. The packaged torrc does not set User or RunAsDaemon.
. /etc/rc.d/rc.subr

rc_bg=YES
rc_stop_signal=INT

rc_configtest() {
	rc_exec "${daemon} --verify-config"
}

rc_cmd "$1"
