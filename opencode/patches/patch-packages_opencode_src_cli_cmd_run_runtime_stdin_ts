@@ -12,6 +12,14 @@ function openTerminalStdin(path: string): NodeJS.ReadStream
   return new tty.ReadStream(fs.openSync(path, "r"))
 }
 
+export async function readStdinText(stdin: NodeJS.ReadStream = process.stdin) {
+  let result = ""
+  for await (const chunk of stdin) {
+    result += typeof chunk === "string" ? chunk : chunk.toString("utf8")
+  }
+  return result
+}
