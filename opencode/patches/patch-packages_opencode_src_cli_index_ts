Lazy-load the TUI command to avoid pulling in Bun-native TUI
dependencies (opentui/core, opentui/solid) during CLI startup.
The TUI command is only imported when the "tui" subcommand runs.
This is safe because the TUI command is not needed for CLI mode.

Index: packages/opencode/src/index.ts
--- packages/opencode/src/index.ts.orig
+++ packages/opencode/src/index.ts
@@ -19,7 +19,6 @@
 import { ExportCommand } from "./cli/cmd/export"
 import { ImportCommand } from "./cli/cmd/import"
 import { AttachCommand } from "./cli/cmd/attach"
-import { TuiThreadCommand } from "./cli/cmd/tui"
 import { AcpCommand } from "./cli/cmd/acp"
 import { EOL } from "os"
 import { WebCommand } from "./cli/cmd/web"
@@ -81,7 +80,7 @@
   .command(AcpCommand)
   .command(McpCommand)
-  .command(TuiThreadCommand)
+  .command({ command: "tui", describe: "start the terminal UI", builder: (yargs) => yargs, handler: async (argv) => { try { const { TuiThreadCommand } = await import("./cli/cmd/tui"); await TuiThreadCommand.handler(argv); } catch(e) { console.error("TUI unavailable: " + (e?.message || e)); process.exit(1); } } })
   .command(AttachCommand)
   .command(RunCommand)
   .command(GenerateCommand)
   .command(DebugCommand)
