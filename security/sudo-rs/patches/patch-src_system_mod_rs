+    /// Get the process starting time of a specific process.
+    ///
+    /// OpenBSD reports the start time as a wall clock time rather than
+    /// relative to boot; the value is only used to tell processes apart in
+    /// the timestamp records, so the reference point does not matter.
+    #[cfg(target_os = "openbsd")]
+    pub fn starting_time(pid: WithProcess) -> io::Result<ProcessCreateTime> {
+        let ki_proc = Self::get_proc_info(pid)?;
+
+        Ok(ProcessCreateTime::new(
+            ki_proc.p_ustart_sec as i64,
+            i64::from(ki_proc.p_ustart_usec) * 1000,
+        ))
+    }
