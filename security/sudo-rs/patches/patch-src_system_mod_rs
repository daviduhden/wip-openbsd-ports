+    #[cfg(target_os = "openbsd")]
+    fn get_proc_info(pid: WithProcess) -> std::io::Result<libc::kinfo_proc> {
+        use std::ffi::c_void;
+        use std::ptr;
+
+        let pid = match pid {
+            WithProcess::Current => std::process::id() as i32,
+            WithProcess::Other(pid) => pid.inner(),
+        };
+
+        let mib = [libc::CTL_KERN, libc::KERN_PROC, libc::KERN_PROC_PID, pid];
+
+        let mut ki_proc = MaybeUninit::<libc::kinfo_proc>::uninit();
+        let mut size = size_of::<libc::kinfo_proc>();
+        // SAFETY: sysctl writes at most `size` bytes into the buffer and
+        // updates `size` with the number of bytes that were written.
+        cerr(unsafe {
+            libc::sysctl(
+                mib.as_ptr(),
+                mib.len() as c_uint,
+                ki_proc.as_mut_ptr().cast::<c_void>(),
+                &mut size,
+                ptr::null_mut(),
+                0,
+            )
+        })?;
+
+        if size < size_of::<libc::kinfo_proc>() {
+            return Err(io::Error::other(
+                "sysctl(KERN_PROC_PID) did not return a full kinfo_proc",
+            ));
+        }
+
+        // SAFETY: the successful sysctl call initialized at least `size` bytes.
+        Ok(unsafe { ki_proc.assume_init() })
+    }
+
+    /// Returns the device identifier of the TTY device that is currently
+    /// attached to the given process
+    #[cfg(target_os = "openbsd")]
+    pub fn tty_device_id(pid: WithProcess) -> std::io::Result<Option<DeviceId>> {
+        let ki_proc = Self::get_proc_info(pid)?;
+
+        if ki_proc.p_tdev == u32::MAX {
+            Ok(None)
+        } else {
+            Ok(Some(DeviceId::new(ki_proc.p_tdev as libc::dev_t)))
+        }
+    }
