+            return Err(io::Error::other(
+                "sysctl(KERN_PROC_PID) did not return a full kinfo_proc",
+            ));
+        }
+
+        // SAFETY: the successful sysctl call initialized at least `size` bytes.
+        Ok(unsafe { ki_proc.assume_init() })
