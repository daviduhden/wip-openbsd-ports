Consume the ptyprocess tree fetched with DIST_TUPLE (and patched for
OpenBSD) as a path dependency, instead of resolving the crate from the
registry.

Index: Cargo.toml
--- Cargo.toml.orig
+++ Cargo.toml
@@ -117,3 +117,7 @@ panic = "abort"
 [profile.bench]
 inherits = "release"
 strip = "debuginfo"
+
+[patch.crates-io]
+# Consumed from the tree fetched with DIST_TUPLE and patched for OpenBSD.
+ptyprocess = { path = "ptyprocess" }
