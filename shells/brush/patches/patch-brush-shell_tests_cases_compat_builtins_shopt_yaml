SPDX-License-Identifier: MIT

Detect OpenBSD as a test-harness host OS and skip the compatibility
cases that differ on OpenBSD (pty/oracle output, ulimit to infinity,
extglob handling).

Index: brush-shell/tests/cases/compat/builtins/shopt.yaml
--- brush-shell/tests/cases/compat/builtins/shopt.yaml.orig
+++ brush-shell/tests/cases/compat/builtins/shopt.yaml
@@ -10,7 +10,7 @@
   - name: "shopt interactive defaults"
     ignore_whitespace: true # Spacing changes across versions
     min_oracle_version: 5.3 # Options changed in bash 5.3
-    incompatible_os: ["fedora"] # Fedora enables "syslog-history" option
+    incompatible_os: ["fedora", "openbsd"] # Fedora: syslog-history; OpenBSD: oracle output under pty
     pty: true
     args: ["-i", "-c", "shopt | sort | grep -v extglob"]
 
@@ -23,6 +23,7 @@
   - name: "shopt -o interactive defaults"
     ignore_whitespace: true # Spacing changes across versions
     min_oracle_version: 5.3 # Options changed in bash 5.3
+    incompatible_os: ["openbsd"] # Oracle produces no output under the pty
     pty: true
     args: ["-i", "-c", "shopt -o | sort | grep -v monitor"]
 
@@ -39,6 +40,7 @@
   - name: "shopt -o interactive monitor default"
     ignore_whitespace: true # Spacing changes across versions
     min_oracle_version: 5.3 # Options changed in bash 5.3
+    incompatible_os: ["openbsd"] # Oracle produces no output under the pty
     pty: true
     args: ["-i", "-c", "shopt -o monitor"]
 
