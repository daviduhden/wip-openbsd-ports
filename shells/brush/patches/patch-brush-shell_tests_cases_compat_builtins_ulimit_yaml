Skip unlimited data and resident-memory limit comparisons on OpenBSD,
whose Bash oracle and brush results differ for those resource limits.

Index: brush-shell/tests/cases/compat/builtins/ulimit.yaml
--- brush-shell/tests/cases/compat/builtins/ulimit.yaml.orig
+++ brush-shell/tests/cases/compat/builtins/ulimit.yaml
@@ -25,6 +25,7 @@ cases:
       ulimit -n

   - name: "ulimit -d unlimited"
+    incompatible_os: ["openbsd"] # differs from bash on OpenBSD
     stdin: |
       ulimit -d unlimited

@@ -33,5 +34,6 @@ cases:
       ulimit -f unlimited

   - name: "ulimit -m unlimited"
+    incompatible_os: ["openbsd"] # differs from bash on OpenBSD
     stdin: |
       ulimit -m unlimited
