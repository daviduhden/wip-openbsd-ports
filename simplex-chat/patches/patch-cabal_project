$OpenBSD$

Relax bounds via allow-newer for GHC 9.10+ compatibility (core
packages only, avoids rebuilding network/unix-time from hackage).
Drop index-state pin to use current Hackage snapshot.

--- cabal.project
+++ cabal.project
@@ -11,7 +11,22 @@
 --    coverage: False
 --    library-coverage: False
 
-index-state: 2023-12-12T00:00:00Z
+-- index-state: 2023-12-12T00:00:00Z
+
+-- Relax bounds for GHC 9.10+ (core packages only)
+allow-newer:
+  base,
+  ghc-prim,
+  template-haskell,
+  Cabal,
+  directory,
+  process,
+  unix,
+  time,
+  bytestring,
+  containers,
+  deepseq,
+  filepath
 
 package cryptostore
     flags: +use_crypton
