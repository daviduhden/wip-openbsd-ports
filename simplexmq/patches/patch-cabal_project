$OpenBSD$

Add patched deps as local packages. allow-newer for GHC 9.10+,
drop index-state.

--- cabal.project
+++ cabal.project
@@ -1,4 +1,4 @@
-packages: .
+packages: . ../deps/splitmix ../deps/aeson ../deps/warp ../deps/tls ../deps/cryptostore
 -- packages: . ../direct-sqlcipher ../sqlcipher-simple
 -- packages: . ../hs-socks
 -- packages: . ../http2
@@ -13,7 +13,10 @@
    -- coverage: False
    -- library-coverage: False
 
-index-state: 2023-12-12T00:00:00Z
+-- index-state: 2023-12-12T00:00:00Z
+
+-- Relax bounds for GHC 9.10+ compatibility
+allow-newer: *
 
 package cryptostore
     flags: +use_crypton
