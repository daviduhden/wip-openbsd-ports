$OpenBSD$

Fix ClientConfig for http2-5.x: use H.defaultClientConfig with H.Authority String.
strEncode host returns ByteString — B.unpack converts to String.

--- src/Simplex/Messaging/Transport/HTTP2/Client.hs.orig
+++ src/Simplex/Messaging/Transport/HTTP2/Client.hs
@@ -212,5 +212,5 @@
 runHTTP2ClientWith :: forall a p. BufferSize -> TransportHost -> ((TLS p -> IO a) -> IO a) -> (TLS p -> H.Client a) -> IO a
 runHTTP2ClientWith bufferSize host setup client = setup $ \tls -> withHTTP2 bufferSize (run tls) (pure ()) tls
   where
     run :: TLS p -> H.Config -> IO a
-    run tls cfg = H.run (ClientConfig "https" (strEncode host) 20) cfg $ client tls
+    run tls cfg = H.run (H.defaultClientConfig { H.scheme = "https", H.authority = B.unpack (strEncode host), H.cacheLimit = 20 }) cfg $ client tls
