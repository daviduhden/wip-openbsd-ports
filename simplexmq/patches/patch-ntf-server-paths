$OpenBSD$

Use OpenBSD-style config and data paths for the notification server.
This keeps the runtime state under /etc/simplex and /var/simplex.

--- apps/ntf-server/Main.hs.orig
+++ apps/ntf-server/Main.hs
@@ -5,10 +5,10 @@
 import Simplex.Messaging.Notifications.Server.Main
 
 defaultCfgPath :: FilePath
-defaultCfgPath = "/etc/opt/simplex-notifications"
+defaultCfgPath = "/etc/simplex/ntf-server"
 
 defaultLogPath :: FilePath
-defaultLogPath = "/var/opt/simplex-notifications"
+defaultLogPath = "/var/simplex/ntf-server"
 
 logCfg :: LogConfig
 logCfg = LogConfig {lc_file = Nothing, lc_stderr = True}
