Close the SQLCipher stores opened by the final schema-dump tests.  Open file
descriptors do not by themselves keep the GHC runtime alive, so this is not the
primary shutdown fix, but leaving three connections open until process exit
makes the suite's final directory cleanup race unnecessary and hides genuine
store-lifetime mistakes.

Index: tests/AgentTests/SchemaDump.hs
--- tests/AgentTests/SchemaDump.hs.orig
+++ tests/AgentTests/SchemaDump.hs
@@ -6,2 +6,3 @@
 import Control.DeepSeq
+import Control.Exception (bracket)
 import Control.Monad (unless, void)
@@ -56,2 +57,3 @@ testVerifySchemaDump
-  void $ createDBStore (DBOpts testDB [] "" False True TQOff) appMigrations (MigrationConfig MCConsole Nothing)
-  getSchema testDB appSchema `shouldReturn` savedSchema
+  Right st <- createDBStore (DBOpts testDB [] "" False True TQOff) appMigrations (MigrationConfig MCConsole Nothing)
+  bracket (pure st) closeDBStore $ \_ ->
+    getSchema testDB appSchema `shouldReturn` savedSchema
@@ -64,2 +66,3 @@ testVerifyLintFKeyIndexes
-  void $ createDBStore (DBOpts testDB [] "" False True TQOff) appMigrations (MigrationConfig MCConsole Nothing)
-  getLintFKeyIndexes testDB "tests/tmp/agent_lint.sql" `shouldReturn` savedLint
+  Right st <- createDBStore (DBOpts testDB [] "" False True TQOff) appMigrations (MigrationConfig MCConsole Nothing)
+  bracket (pure st) closeDBStore $ \_ ->
+    getLintFKeyIndexes testDB "tests/tmp/agent_lint.sql" `shouldReturn` savedLint
@@ -95,2 +98,3 @@ testVerifyStrict
-  withTransaction' st (`SQL.query_` "SELECT name FROM sqlite_master WHERE type = 'table' AND name != 'sqlite_sequence' AND sql NOT LIKE '% STRICT'")
-    `shouldReturn` ([] :: [Only Text])
+  bracket (pure st) closeDBStore $ \st' ->
+    withTransaction' st' (`SQL.query_` "SELECT name FROM sqlite_master WHERE type = 'table' AND name != 'sqlite_sequence' AND sql NOT LIKE '% STRICT'")
+      `shouldReturn` ([] :: [Only Text])
