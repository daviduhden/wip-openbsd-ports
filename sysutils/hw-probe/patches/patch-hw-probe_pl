+# The path is placed on a command line that can run as root.
+if(defined $Opt{"HWInfoPath"} and not -x $Opt{"HWInfoPath"})
+{
+    printMsg("ERROR", "hwinfo path is not an executable file");
+    exitStatus(1);
+}
