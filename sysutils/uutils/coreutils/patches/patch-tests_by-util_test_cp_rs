@@ -3978,6 +3978,10 @@ fn test_cp_recursive_char_device(#[case] flag: &str) {
     ignore = "WASI sandbox: host paths (/dev, /private) not visible"
 )]
 fn test_cp_recursive_char_device_no_permission(#[case] flag: &str) {
+    if uutests::util::is_root() {
+        // The filesystem permission checks are bypassed when running as root.
+        return;
+    }
     new_ucmd!()
         .args(&[flag, "/dev/null", "null2"])
         .fails()
