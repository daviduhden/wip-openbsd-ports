Build diff and cmp as independent binaries while retaining the multicall
binary required by upstream tests. Only diff and cmp are installed.

Index: Cargo.toml
--- Cargo.toml.orig
+++ Cargo.toml
@@ -12,6 +12,14 @@
 
 [[bin]]
 name = "diffutils"
+path = "src/main.rs"
+
+[[bin]]
+name = "diff"
+path = "src/main.rs"
+
+[[bin]]
+name = "cmp"
 path = "src/main.rs"
 
 [dependencies]
