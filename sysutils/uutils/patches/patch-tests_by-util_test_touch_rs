Make the uutils test suite pass on OpenBSD.  Tests that rely on the
filesystem denying access are skipped when running as root (the ports
test target runs with root privileges), matching the GNU coreutils
test suite.  Also treat the xattr crate's unsupported-platform error
as ENOTSUP so optional attribute preservation is silent on OpenBSD.

Index: tests/by-util/test_touch.rs
--- tests/by-util/test_touch.rs.orig
+++ tests/by-util/test_touch.rs
@@ -819,6 +819,10 @@ fn test_touch_mtime_dst_fails() {
     ignore = "WASI: guest root is a writable preopen, not the protected system root"
 )]
 fn test_touch_system_fails() {
+    if uutests::util::is_root() {
+        // The filesystem permission checks are bypassed when running as root.
+        return;
+    }
     let file = "/";
     new_ucmd!()
         .args(&[file])
@@ -923,6 +927,10 @@ fn test_touch_changes_time_of_file_in_stdout() {
     ignore = "WASI: filesystem permission errors surface as ENOENT rather than EACCES"
 )]
 fn test_touch_permission_denied_error_msg() {
+    if uutests::util::is_root() {
