+#ifdef __OpenBSD__
+/* Create an unlinked read/write temp file inside Lynx's private temp area. */
+static FILE *lynx_bookmark_tmpfile(void)
+{
+    char path[LY_MAXPATH];
+    FILE *fp;
+    int fd;
+    int n;
+
+    n = snprintf(path, sizeof(path), "%slynx-bookmark.XXXXXX",
+		 lynx_temp_space);
+    if (n < 0 || n >= (int) sizeof(path)) {
+	errno = ENAMETOOLONG;
+	return NULL;
+    }
+    fd = mkstemp(path);
+    if (fd == -1)
+	return NULL;
+    fp = fdopen(fd, "w+");
+    if (fp == NULL) {
+	int saved_errno = errno;
+
+	close(fd);
+	(void) unlink(path);
+	errno = saved_errno;
+	return NULL;
+    }
+    if (unlink(path) == -1) {
+	int saved_errno = errno;
+
+	fclose(fp);
+	(void) unlink(path);
+	errno = saved_errno;
+	return NULL;
+    }
+    return fp;
+}
+#endif
