+/*
+ * Sandbox helpers.  Read access is limited to help/configuration,
+ * exact TLS trust files, terminal data and user state.  Writable access
+ * is limited to private temp/save directories and files Lynx owns.
+ */
+static void unveil_fatal(const char *path)
+{
+    fprintf(stderr, "%s: unveil %s: %s\n",
+	    getprogname(), NonNull(path), strerror(errno));
+    if (LYCursesON)
+	stop_curses();
+    exit_immediately(EXIT_FAILURE);
+}
+
+/* Queue canonical paths before applying the first unveil rule. */
+static void unveil_rule_add(const char *path, const char *perms)
+{
+    struct UnveilRule *rule;
+    const char *p;
+
+    for (rule = UnveilRules; rule != NULL; rule = rule->next) {
+	if (strcmp(rule->path, path) == 0) {
+	    for (p = perms; *p != '\0'; ++p) {
+		if (strchr(rule->perms, *p) == NULL) {
+		    size_t len = strlen(rule->perms);
+		    if (len + 1 >= sizeof(rule->perms)) {
+			errno = EINVAL;
+			unveil_fatal(path);
+			return;
+		    }
+		    rule->perms[len] = *p;
+		    rule->perms[len + 1] = '\0';
+		}
+	    }
+	    return;
+	}
+    }
+
+    for (p = perms; *p != '\0'; ++p) {
+	if (strchr("rwcx", *p) == NULL ||
+	    (size_t) (p - perms) >= sizeof(rule->perms) - 1) {
+	    errno = EINVAL;
+	    unveil_fatal(path);
+	    return;
+	}
+    }
+    rule = calloc(1, sizeof(*rule));
+    if (rule == NULL || (rule->path = strdup(path)) == NULL) {
+	free(rule);
+	unveil_fatal(path);
+	return;
+    }
+    for (p = perms; *p != '\0'; ++p) {
+	size_t len = strlen(rule->perms);
+	if (strchr(rule->perms, *p) == NULL && len + 1 < sizeof(rule->perms)) {
+	    rule->perms[len] = *p;
+	    rule->perms[len + 1] = '\0';
+	}
+    }
+    rule->next = UnveilRules;
+    UnveilRules = rule;
+}
+
+static void unveil_apply_rules(void)
+{
+    struct UnveilRule *rule = UnveilRules;
+    struct UnveilRule *next;
+
+    while (rule != NULL) {
+	if (unveil(rule->path, rule->perms) == -1)
+	    unveil_fatal(rule->path);
+	rule = rule->next;
+    }
+    rule = UnveilRules;
+    while (rule != NULL) {
+	next = rule->next;
+	free(rule->path);
+	free(rule);
+	rule = next;
+    }
+    UnveilRules = NULL;
+}
+
+static int unveil_has_dotdot(const char *path)
+{
+    const char *p = path;
+
+    while ((p = strstr(p, "..")) != NULL) {
+	if ((p == path || p[-1] == '/') &&
+	    (p[2] == '\0' || p[2] == '/'))
+	    return 1;
+	p += 2;
+    }
+    return 0;
+}
+
+static void unveil_path(const char *path, const char *perms, int required)
+{
+    char *resolved;
+
+    if (path == NULL || *path == '\0')
+	return;
+    if (unveil_has_dotdot(path)) {
+	fprintf(stderr, "%s: refusing unveil path with ..: %s\n",
+		getprogname(), path);
+	exit_immediately(EXIT_FAILURE);
+    }
+    resolved = realpath(path, NULL);
+    if (resolved == NULL) {
+	if (!required && errno == ENOENT)
+	    return;
+	unveil_fatal(path);
+	return;
+    }
+    if (!strcmp(resolved, "/")) {
+	/* Never grant a root rule; cwd may legitimately be /. */
+	if (required) {
+	    fprintf(stderr, "%s: refusing required root rule: %s\n",
+		    getprogname(), path);
+	    if (LYCursesON)
+		stop_curses();
+	    exit_immediately(EXIT_FAILURE);
+	}
+	free(resolved);
+	return;
+    }
+    unveil_rule_add(resolved, perms);
+    free(resolved);
+}
+
+/*
+ * Unveil a directory only.  Environment overrides such as SSL_CERT_DIR
+ * must not turn a mistyped file path into a broad directory rule.
+ */
+static void unveil_dir(const char *path, const char *perms, int required)
+{
+    char *resolved;
+    struct stat st;
+
+    if (path == NULL || *path == '\0')
+	return;
+    if (unveil_has_dotdot(path)) {
+	fprintf(stderr, "%s: refusing unveil path with ..: %s\n",
+		getprogname(), path);
+	exit_immediately(EXIT_FAILURE);
+	return;
+    }
+    resolved = realpath(path, NULL);
+    if (resolved == NULL) {
+	if (!required && errno == ENOENT)
+	    return;
+	unveil_fatal(path);
+	return;
+    }
+    if (!strcmp(resolved, "/")) {
+	if (required) {
+	    fprintf(stderr, "%s: refusing required root rule: %s\n",
+		    getprogname(), path);
+	    if (LYCursesON)
+		stop_curses();
+	    exit_immediately(EXIT_FAILURE);
+	}
+	free(resolved);
+	return;
+    }
+    if (stat(resolved, &st) != 0 || !S_ISDIR(st.st_mode)) {
+	free(resolved);
+	return;
+    }
+    unveil_rule_add(resolved, perms);
+    free(resolved);
+}
+
+/* Keep writable sandbox roots private to the invoking user. */
+static void unveil_private_dir(const char *path, const char *perms)
+{
+    char *resolved;
+    struct stat st;
+
+    if (path == NULL || *path == '\0')
+	return;
+    resolved = realpath(path, NULL);
+    if (resolved == NULL || stat(resolved, &st) != 0 ||
+	!S_ISDIR(st.st_mode) || st.st_uid != getuid() ||
+	(st.st_mode & 0077) != 0 || (st.st_mode & 0700) != 0700) {
+	if (resolved != NULL)
+	    free(resolved);
+	fprintf(stderr, "%s: sandbox directory must be owned by the user "
+		"and mode 0700: %s\n", getprogname(), NonNull(path));
+	if (LYCursesON)
+	    stop_curses();
+	exit_immediately(EXIT_FAILURE);
+	return;
+    }
+    unveil_rule_add(resolved, perms);
+    free(resolved);
+}
