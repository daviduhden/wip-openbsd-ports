+#ifdef __OpenBSD__
+/*
+ * Sandbox helpers.  Read access is limited to the help/configuration
+ * trees, the TLS trust store, terminal data and the user's own state
+ * files.  Write access is limited to the current directory, the
+ * configured temp/save areas and the individual files Lynx owns.
+ */
+static void unveil_fatal(const char *path)
+{
+    fprintf(stderr, "%s: unveil %s: %s\n",
+	    getprogname(), NonNull(path), strerror(errno));
+    if (LYCursesON)
+	stop_curses();
+    exit_immediately(EXIT_FAILURE);
+}
+
+static int unveil_has_dotdot(const char *path)
+{
+    const char *p = path;
+
+    while ((p = strstr(p, "..")) != NULL) {
+	if ((p == path || p[-1] == '/') &&
+	    (p[2] == '\0' || p[2] == '/'))
+	    return 1;
+	p += 2;
+    }
+    return 0;
+}
+
+static void unveil_path(const char *path, const char *perms, int required)
+{
+    char *resolved;
+
+    if (path == NULL || *path == '\0')
+	return;
+    if (unveil_has_dotdot(path)) {
+	fprintf(stderr, "%s: refusing unveil path with ..: %s\n",
+		getprogname(), path);
+	exit_immediately(EXIT_FAILURE);
+    }
+    resolved = realpath(path, NULL);
+    if (resolved == NULL) {
+	if (!required && errno == ENOENT)
+	    return;
+	unveil_fatal(path);
+	return;
+    }
+    if (!strcmp(resolved, "/")) {
+	/* Never grant a root rule; cwd may legitimately be /. */
+	if (required) {
+	    fprintf(stderr, "%s: refusing required root rule: %s\n",
+		    getprogname(), path);
+	    if (LYCursesON)
+		stop_curses();
+	    exit_immediately(EXIT_FAILURE);
+	}
+	free(resolved);
+	return;
+    }
+    if (unveil(resolved, perms) == -1) {
+	int saved_errno = errno;
+
+	free(resolved);
+	errno = saved_errno;
+	if (!required && errno == ENOENT)
+	    return;
+	unveil_fatal(path);
+	return;
+    }
+    free(resolved);
+}
+
+/*
+ * Unveil a directory only.  Environment overrides such as SSL_CERT_DIR
+ * must not turn a mistyped file path into a broad directory rule.
+ */
+static void unveil_dir(const char *path, const char *perms, int required)
+{
+    char *resolved;
+    struct stat st;
+
+    if (path == NULL || *path == '\0')
+	return;
+    resolved = realpath(path, NULL);
+    if (resolved == NULL) {
+	if (!required && errno == ENOENT)
+	    return;
+	unveil_fatal(path);
+	return;
+    }
+    if (stat(resolved, &st) != 0 || !S_ISDIR(st.st_mode)) {
+	free(resolved);
+	return;
+    }
+    free(resolved);
+    unveil_path(path, perms, required);
+}
+
+/*
+ * Unveil a file that may not exist yet.  If realpath() succeeds, use
+ * its resolved name; otherwise resolve the parent directory and append
+ * the leaf.  This keeps file creation inside the already checked
+ * directory.
+ */
+static void unveil_file(const char *path, const char *perms, int required)
+{
+    char cwd[LY_MAXPATH];
+    char *copy = NULL;
+    char *slash;
+    char *parent = NULL;
+    char *base;
+    char *resolved;
+    char combined[LY_MAXPATH];
+    struct stat st;
+    int n;
+
+    if (path == NULL || *path == '\0')
+	return;
+    if (unveil_has_dotdot(path)) {
+	fprintf(stderr, "%s: refusing unveil path with ..: %s\n",
+		getprogname(), path);
+	exit_immediately(EXIT_FAILURE);
+    }
+    resolved = realpath(path, NULL);
+    if (resolved != NULL) {
+	if (stat(resolved, &st) == 0 && S_ISDIR(st.st_mode)) {
+	    /* This helper is for files, never whole directories. */
+	    free(resolved);
+	    return;
+	}
+	if (!strcmp(resolved, "/")) {
+	    if (required) {
+		fprintf(stderr, "%s: refusing required root rule: %s\n",
+			getprogname(), path);
+		if (LYCursesON)
+		    stop_curses();
+		exit_immediately(EXIT_FAILURE);
+	    }
+	    free(resolved);
+	    return;
+	}
+	if (unveil(resolved, perms) == -1) {
+	    int saved_errno = errno;
+
+	    free(resolved);
+	    errno = saved_errno;
+	    if (!required && errno == ENOENT)
+		return;
+	    unveil_fatal(path);
+	    return;
+	}
+	free(resolved);
+	return;
+    }
+    if (errno != ENOENT) {
+	unveil_fatal(path);
+	return;
+    }
+    StrAllocCopy(copy, path);
+    slash = strrchr(copy, '/');
+    if (slash == NULL) {
+	/*
+	 * A bare filename is relative to cwd.  Resolve the directory
+	 * rather than unveiling cwd itself for a writable file.
+	 */
+	base = copy;
+	if (Current_Dir(cwd) == NULL) {
+	    FREE(copy);
+	    return;
+	}
+	parent = realpath(cwd, NULL);
+    } else {
+	base = slash + 1;
+	if (*base == '\0') {
+	    FREE(copy);
+	    return;
+	}
+	if (slash == copy) {
+	    parent = realpath("/", NULL);
+	} else {
+	    *slash = '\0';
+	    parent = realpath(copy, NULL);
+	}
+    }
+    if (parent == NULL) {
+	int saved_errno = errno;
+
+	FREE(copy);
+	if (!required && saved_errno == ENOENT)
+	    return;
+	errno = saved_errno;
+	unveil_fatal(path);
+	return;
+    }
+    n = snprintf(combined, sizeof(combined), "%s%s%s",
+		 parent, (!strcmp(parent, "/") ? "" : "/"), base);
+    if (n < 0 || n >= (int) sizeof(combined)) {
+	free(parent);
+	FREE(copy);
+	unveil_fatal(path);
+	return;
+    }
+    if (unveil(combined, perms) == -1) {
+	int saved_errno = errno;
+
+	free(parent);
+	FREE(copy);
+	errno = saved_errno;
+	if (!required && errno == ENOENT)
+	    return;
+	unveil_fatal(path);
+	return;
+    }
+    free(parent);
+    FREE(copy);
+}
