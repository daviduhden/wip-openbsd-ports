+/*
+ * True when path resolves to HOME or to an ancestor of HOME.  Such a
+ * rule would expose the whole home tree, whether for reading or writing,
+ * and defeat the exact-file policy below.
+ */
+static int unveil_covers_home(const char *path, const char *home_real)
+{
+    char *resolved;
+    int result = 0;
+
+    if (path == NULL || *path == '\0' || home_real == NULL)
+	return 0;
+    resolved = realpath(path, NULL);
+    if (resolved == NULL)
+	return 0;
+    if (!strcmp(resolved, "/") || !strcmp(resolved, home_real)) {
+	result = 1;
+    } else {
+	size_t path_len = strlen(resolved);
+	size_t home_len = strlen(home_real);
+
+	if (path_len < home_len &&
+	    !strncmp(home_real, resolved, path_len) &&
+	    home_real[path_len] == '/')
+	    result = 1;
+    }
+    free(resolved);
+    return result;
+}
+
+/* Expose Downloads only when it is the real HOME/Downloads directory. */
+static void unveil_home_downloads(const char *path, const char *home_real)
+{
+    char expected[LY_MAXPATH];
+    char *resolved;
+    char *save_real;
+    int n;
+
+    if (path == NULL || *path == '\0' || home_real == NULL)
+	return;
+    n = snprintf(expected, sizeof(expected), "%s%sDownloads",
+		 home_real, (!strcmp(home_real, "/") ? "" : "/"));
+    if (n < 0 || n >= (int) sizeof(expected))
+	return;
+    resolved = realpath(path, NULL);
+    if (resolved == NULL)
+	return;
+    if (!strcmp(resolved, expected)) {
+	/* A configured save root already has its exact writable rule. */
+	save_real = non_empty(lynx_save_space)
+	    ? realpath(lynx_save_space, NULL)
+	    : NULL;
+	if (save_real != NULL && !strcmp(save_real, resolved)) {
+	    free(save_real);
+	    free(resolved);
+	    return;
+	}
+	free(save_real);
+	/* Browsing Downloads does not need write access to the whole folder. */
+	unveil_path(resolved, "r", 0);
+    }
+    free(resolved);
+}
