+/* Force LYOpenTemp() to establish and validate its private temp area. */
+static void unveil_prepare_tempdir(void)
+{
+    char temp_file[LY_MAXPATH];
+    FILE *fp;
+
+    fp = LYOpenTemp(temp_file, ".sandbox", "w");
+    if (fp == NULL) {
+	unveil_fatal(lynx_temp_space);
+	return;
+    }
+    LYCloseTempFP(fp);
+    if (LYRemoveTemp(temp_file) != 0)
+	unveil_fatal(temp_file);
+}
