+#ifdef __OpenBSD__
+static int spawn_detached(char *const argv[])
+{
+	int fd[2], rv = 0;
+	pid_t pid;
+	size_t received = 0;
+	ssize_t n;
+	if(pipe2(fd, O_CLOEXEC) == -1) return errno;
+	pid = fork();
+	if(pid == -1) {
+		rv = errno;
+		close(fd[0]);
+		close(fd[1]);
+		return rv;
+	}
+	if(pid == 0) {
+		close(fd[0]);
+		if(setsid() != -1) execvp(argv[0], argv);
+		rv = errno;
+		do {
+			n = write(fd[1], &rv, sizeof(rv));
+		} while(n == -1 && errno == EINTR);
+		_exit(EXIT_FAILURE);
+	}
+	close(fd[1]);
+	while(received < sizeof(rv)) {
+		n = read(fd[0], (char *)&rv + received, sizeof(rv) - received);
+		if(n == -1 && errno == EINTR) continue;
+		if(n == -1) {
+			rv = errno;
+			break;
+		}
+		if(n == 0) {
+			if(received) rv = EIO;
+			break;
+		}
+		received += n;
+	}
+	close(fd[0]);
+	return rv;
+}
+#endif
